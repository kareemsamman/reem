{%- comment -%}
  Renders product media item.
  Accepts:

  - media: {Object} Product Media object
  - position: {interger} Position of the media.
  - group_media_obj: {Json}
  - class: {String} a class list
  - loop: {Boolean} Enable video looping (optional)
  - lazy_load: {Boolean} Image should be lazy loaded. Default: true (optional)
  - variant_images: {array} a array width image
  - selected_values: {string} the selected variant option values concatenated with '-'
  - selected_values_arr: {array} the selected variant option values split into an array
  - un_no_pick: {boolean}

  Usage:
  {%- render 'media-thumb' -%}
{%- endcomment -%}

{%- liquid
    assign image = media.preview_image
    if group_media_obj.size > 0
      assign position = position | minus: 1
      assign media_group = group_media_obj.medias[position].values
      if un_no_pick
      assign media_hidden = 'hidden'
      endif
      if selected_values != blank
        if media_group contains '*'
          assign media_group_all = media_group | replace_first: '*0', selected_values_arr[0] | replace_first: '*1', selected_values_arr[1] | replace_first: '*2', selected_values_arr[2]
        else
          assign media_group_all = 'nt94'
        endif
        if media_group == selected_values or media_group_all == selected_values
          assign media_hidden = ''
        endif
      endif
    endif
  -%}

  <div {{ media_hidden }} class="{{ class }} hdt-thumbnail__media" data-media-id="{{ media.id }}" data-media-type="{{ media.media_type }}" data-group-values="{{ media_group }}">
    <div {% if media.position <= 15 %}reveal{% endif %} class="hdt-thumbnail__media-inner hdt-ratio hdt-radius-f" style="--aspect-ratioapt:{{ image.aspect_ratio }};">
      {%- liquid
          case media.media_type
            when 'video' or 'external_video'
              echo '<span class="hdt-thumbnail__badge not-apply-ratio">'
              echo 'icon-video-play.svg' | inline_asset_content
              echo '</span>'
            when 'model'
              echo '<span class="hdt-thumbnail__badge not-apply-ratio">'
              echo 'icon-3d-model.svg' | inline_asset_content
              echo '</span>'
          endcase
          echo media | image_url: width: 300 | image_tag: class: image_class, sizes: '150px', widths: '100, 200, 300', loading: 'lazy'
        -%}
    </div>
  </div>
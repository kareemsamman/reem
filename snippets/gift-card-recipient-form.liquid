{%- comment -%}
  Renders gift card recipient form.
  Accepts:
  - form: {Object} the product form object.
  - block_id: {String} section id.

  Usage:
  {%- render 'gift-card-recipient-form', form: form -%}
{%- endcomment -%}

{%- assign gift_card_recipient_control_flag = 'properties[__shopify_send_gift_card_to_recipient]' -%}
{%- assign block_id =  block.id -%}

<hdt-recipient-form class="hdt-recipient-form hdt-s-text hdt-form--move-text" data-block-id="{{ block.id }}">
    <input class="hdt-recipient-checkbox" id="Recipient-checkbox-{{ block_id }}" type="checkbox" name="{{ gift_card_recipient_control_flag }}" disabled>
    <label class="hdt-recipient-label no-js-hidden" for="Recipient-checkbox-{{ block_id }}"><span>{{ 'recipient.form.checkbox' | t }}</span></label>

    <div class="hdt-form__message-wrapper hdt-form__message--error" role="alert"{% unless form.errors %} hidden{% endunless %}>
        <h2 class="hdt-form__message hdt-h6" tabindex="-1" autofocus>{{ 'icon-error.svg' | inline_asset_content }} <span class="hdt-error-message">{{ 'recipient.form.error_heading' | t }}</span></h2>
        <ul>
        {%- if form.errors -%}
            {%- for field in form.errors -%}
            <li>
                {%- if field == 'form' -%}
                {{ form.errors.messages[field] }}
                {%- else -%}
                <a href="#Recipient-{{ field }}-{{ block_id }}">
                    {{ form.errors.messages[field] }}
                </a>
                {%- endif -%}
            </li>
            {%- endfor -%}
        {%- endif -%}
        </ul>
    </div>
    <p id="Recipient-fields-live-region-{{ block_id }}" class="sr-only" role="status" data-expanded="{{ 'recipient.form.expanded' | t | escape }}" data-collapsed="{{ 'recipient.form.collapsed' | t | escape }}">{{ 'recipient.form.collapsed' | t }}</p>
    <div class="hdt-recipient-fields hdt-rounded-sm">
        <div class="hdt-recipient-fields__field">
            <div class="hdt-field">
                <input class="hdt-field__input hdt-input" id="Recipient-email-{{ block_id }}" type="email" name="properties[Recipient email]" placeholder="{{ 'recipient.form.email_label' | t | escape }}" value="{{ form.email }}"{% if form.errors contains 'email' %} aria-invalid="true" aria-describedby="RecipientForm-email-error-{{ block_id }}"{% endif %}>
                <label class="hdt-field__label sr-only" for="Recipient-email-{{ block_id }}">
                    <span class="hdt-recipient-email-label required">{{ 'recipient.form.email_label' | t }}</span>
                    <span class="hdt-recipient-email-label optional">{{ 'recipient.form.email_label_optional_for_no_js_behavior' | t }}</span>
                </label>
            </div>
            <div id="RecipientForm-email-error-{{ block_id }}" class="hdt-form__message"{% unless form.errors contains 'email' %} hidden{% endunless %}>
                {{- 'icon-error.svg' | inline_asset_content -}}
                <span class="hdt-error-message hdt-text-sm">{% if form.errors contains 'email' %}{{ form.errors.messages.email }}.{% endif %}</span>
            </div>
        </div>
        <div class="hdt-recipient-fields__field">
            <div class="hdt-field">
                <input class="hdt-field__input hdt-input" autocomplete="name" type="text" id="Recipient-name-{{ block_id }}" name="properties[Recipient name]" placeholder="{{ 'recipient.form.name_label' | t | escape }}" value="{{ form.name }}"{% if form.errors contains 'name' %} aria-invalid="true" aria-describedby="RecipientForm-name-error-{{ block_id }}"{% endif %}>
                <label class="hdt-field__label sr-only" for="Recipient-name-{{ block_id }}"><span>{{- 'recipient.form.name_label' | t -}}</span></label>
            </div>
            <div id="RecipientForm-name-error-{{ block_id }}" class="hdt-form__message"{% unless form.errors contains 'name' %} hidden{% endunless %}>
                {{- 'icon-error.svg' | inline_asset_content -}}
                <span class="hdt-error-message hdt-text-sm">{%- if form.errors contains 'name' -%}{{ form.errors.messages.name }}.{%- endif -%}</span>
            </div>
        </div>
        <div class="hdt-recipient-fields__field">
            {%- assign max_chars_message = 200 -%}
            {%- assign max_chars_message_rendered = 'recipient.form.max_characters' | t: max_chars: max_chars_message -%}
            {%- assign message_label_rendered = 'recipient.form.message_label' | t -%}
            <div class="hdt-field hdt-field-has-textarea-limit">
                <textarea rows="4" id="Recipient-message-{{ block_id }}" class="hdt-textarea hdt-textarea-round-limit" name="properties[Message]" maxlength="{{ max_chars_message }}" placeholder="{{ message_label_rendered | escape }}" aria-label="{{ message_label_rendered }} {{ max_chars_message_rendered }}"{% if form.errors contains 'message' %} aria-invalid="true" aria-describedby="RecipientForm-message-error-{{ block_id }}"{% endif %}>{{ form.message }}</textarea>
                <label class="sr-only" for="Recipient-message-{{ block_id }}"><span>{{ message_label_rendered }}</span></label>
            </div>
            <label class="hdt-text-right hdt-block hdt-text-sm"><span>{{ max_chars_message_rendered }}</span></label>
            <div id="RecipientForm-message-error-{{ block_id }}" class="hdt-form__message"{% unless form.errors contains 'message' %} hidden{% endunless %}>
                {{- 'icon-error.svg' | inline_asset_content -}}
                <span class="hdt-error-message hdt-text-sm">{%- if form.errors contains 'message' -%}{{ form.errors.messages.message }}.{%- endif -%}</span>
            </div>
        </div>
        <div class="hdt-recipient-fields__field">
            <div class="hdt-field hdt-field--date">
                <input class="hdt-field__input hdt-input" autocomplete="send_on" type="date" id="Recipient-send_on-{{ block_id }}" name="properties[Send on]" placeholder="{{ 'recipient.form.send_on_label' | t | escape }}" pattern="\d{4}-\d{2}-\d{2}" value="{{ form.send_on }}"{% if form.errors contains 'send_on' %} aria-invalid="true" aria-describedby="RecipientForm-send_on-error-{{ block_id }}"{% endif %} >
                <label class="hdt-field__label" for="Recipient-send_on-{{ block_id }}"><span>{{ 'recipient.form.send_on_label' | t }}</span></label>
            </div>
            <div id="RecipientForm-send_on-error-{{ block_id }}" class="hdt-form__message"{% unless form.errors contains 'send_on' %} hidden{% endunless %}>
                {{- 'icon-error.svg' | inline_asset_content }} <span class="hdt-error-message hdt-text-sm">{%- if form.errors contains 'send_on' -%}{{ form.errors.messages.send_on }}.{%- endif -%}</span>
            </div>
        </div>
    </div>
    <input type="hidden" name="{{ gift_card_recipient_control_flag }}" value="if_present" id="Recipient-control-{{ block_id }}">
    <input type="hidden" name="properties[__shopify_offset]" value="" id="Recipient-timezone-offset-{{ block_id }}" disabled>
</hdt-recipient-form>
{%- comment -%}
  Renders badges

  Accepts:
  - product: {Object} Product Liquid object (required)
  - use_variant: {Boolean} Renders selected or first variant price instead of overall product pricing (optional)
  - class: {String} a list class.
  - form_id: {String}
  - update_hidden: {Boolean}

  - only_show_sale: {Boolean}
  - use_onsale_badge: {Boolean}
  - label_onsale_style: {String} text or percentage
  - sale_text_t: {String}
  - sale_percent_t: {String}

  Usage:
  {%- render 'badges', product: product -%}
{%- endcomment -%}

{%- liquid
  assign has_pre_order = false
  assign target = product
  assign available = target.available | default: false
  if product.available and settings.use_preorder_badge
    assign variants_available = product.variants | where: 'available'
    assign variants_inventory_shopify = variants_available | where: 'inventory_management', 'shopify'
    if variants_inventory_shopify.size > 0
      assign variants_inventory_quantity = variants_inventory_shopify | map: 'inventory_quantity'
      assign variants_inventory_quantity_str = variants_inventory_quantity | join: ' '
      if variants_inventory_quantity_str contains '-' or variants_inventory_quantity contains 0
        assign has_pre_order = true
      endif
    endif
  endif
  if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price
    assign target = product.selected_or_first_available_variant
    assign on_sale = true
  elsif target.compare_at_price > target.price
    assign on_sale = true
  else
    assign on_sale = false
  endif
  assign new_badge = false
  if settings.use_new_badge
    assign now_timestamp = 'now' | date: '%s'
    assign date_start = product.created_at | date: '%s'
    assign diff = now_timestamp | minus: date_start
    assign diff_seconds = diff | divided_by: 3600 | floor
    assign diff_days = diff_seconds | divided_by: 24 | floor
    if diff_days < settings.new_day_added
      assign new_badge = true
    endif
  endif
  unless label_onsale_style
    assign label_onsale_style = settings.label_onsale_style
  endunless
  unless sale_text_t
    assign sale_text_t = 'products.product.badges.sale' | t
  endunless
  unless sale_percent_t
    if label_onsale_style == 'amount'
      assign sale_percent_t = 'products.product.badges.save_amount' | t: amount: '[1904]' | replace_first: '[1904]', '<span percent>[1904]</span>'
    else
      assign sale_percent_t = 'products.product.badges.save_percent' | t: percent: '[1904]' | replace_first: '[1904]', '<span percent>[1904]</span>'
    endif
  endunless
  if use_onsale_badge == blank and use_onsale_badge != false
    assign use_onsale_badge = settings.use_onsale_badge
  endif
  assign limit = 10
  assign badge_class = 'hdt-text-xs hdt-uppercase'
-%}

{%- if only_show_sale -%}
  {%- if on_sale and use_onsale_badge -%}
    <hdt-badge is="on_sale" class="hdt-badge hdt-badge__on-sale">
      {%- liquid
      if label_onsale_style == 'text'
        echo sale_text_t
      else
        if label_onsale_style == 'amount'
          assign save = target.compare_at_price | minus: target.price | money_without_trailing_zeros
        else
          assign save = target.compare_at_price | minus: target.price | times: 100.0 | divided_by: target.compare_at_price | round | at_least: 1
        endif
        echo sale_percent_t | replace_first: '[1904]', save
      endif -%}
    </hdt-badge>
  {%- endif -%}

{%- else -%}

  {%- capture badges_html -%}
    {%- if product.metafields.theme.bestseller_badge.value %}{% assign bestseller_size = 'products.product.badges.bestseller' | t | size %}<span class="hdt-badge {{ badge_class }} hdt-badge__bestseller{% if bestseller_size > limit %} hdt-badge--large{% endif %}">{{ 'products.product.badges.bestseller' | t }}</span>{% endif -%}
    {%- if on_sale and use_onsale_badge -%}
      {%- liquid
      if label_onsale_style == 'text'
        assign badge_class_sale = badge_class
      else
        assign badge_class_sale = 'hdt-text-sm'
      endif
      -%}
      <hdt-badge is="on_sale" class="hdt-badge {{ badge_class_sale }} hdt-badge__on-sale">
        {%- liquid
        if label_onsale_style == 'text'
          echo sale_text_t
        else
          if label_onsale_style == 'amount'
            assign save = target.compare_at_price | minus: target.price | money_without_trailing_zeros
          else
            assign save = target.compare_at_price | minus: target.price | times: 100.0 | divided_by: target.compare_at_price | round | at_least: 1
          endif
          echo sale_percent_t | replace_first: '[1904]', save
        endif -%}
      </hdt-badge>
    {%- endif -%}
    {%- if settings.use_preorder_badge and has_pre_order %}{% assign pre_order_size = 'products.product.badges.pre_order' | t | size %}<hdt-badge is="pre_order" class="hdt-badge {{ badge_class }} hdt-badge__pre_order{% if pre_order_size > limit %} hdt-badge--large{%  endif %}">{{ 'products.product.badges.pre_order' | t }}</hdt-badge>{% endif -%}
    {%- if settings.use_soldout_badge and available == false %}{% assign sold_out_size = 'products.product.badges.sold_out' | t | size %}<hdt-badge is="sold_out" class="hdt-badge {{ badge_class }} hdt-badge__sold_out{% if sold_out_size > limit %} hdt-badge--large{%  endif %}">{{ 'products.product.badges.sold_out' | t }}</hdt-badge>{% endif -%}
    {%- if new_badge %}<span class="hdt-badge {{ badge_class }} hdt-badge__new">{{ 'products.product.badges.new' | t }}</span>{% endif -%}
    {%- if product.metafields.theme.custom_badges.value != blank and settings.use_custom_badge -%}
      {%- for badge in product.metafields.theme.custom_badges.value limit: 5 -%}
        <span class="hdt-badge hdt-badge__custom {{ badge_class }} hdt-badge__{{ badge | handle }}{% if badge.size > limit %} hdt-badge--large{%  endif %}">{{ badge | escape }}</span>
      {%- endfor -%}
    {%- endif -%}
  {%- endcapture -%}
  {%- if badges_html != blank %}<div class="hdt-badge__wrapp hdt-pe-none {{ class }}">{{- badges_html -}}</div>{% endif -%}
{%- endif -%}
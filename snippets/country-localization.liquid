{%- comment -%}
  Renders the country picker for the localization form
  Accepts:
  - id: {String} The ID (required)
  Usage:
 {%- render 'country-localization' -%}
{%- endcomment -%}

{%- liquid
  assign currencies = localization.available_countries | map: 'currency' | map: 'iso_code' | uniq
  assign popular_countries = localization.available_countries | where: 'popular?' | sort: 'name'
  assign popular_countries_iso = popular_countries | map: 'iso_code' | uniq

  assign show_country_filter = false
  if localization.available_countries.size > 12
    assign show_country_filter = true
  endif

  assign show_popular_countries = false
  if localization.available_countries.size > 9 and popular_countries.size > 1
    assign show_popular_countries = true
  endif

  assign show_currencies = false
  if currencies.size > 1
    assign show_currencies = true
  endif
  assign form_id = id | append: 'CountryForm'
-%}

<hdt-popover class="hdt-contents" placement="top" data-auto-close -only-flip-first update-pos-when-hover-focus{% if id == 'Global' %} popover-active-min-width="99999"{% endif %}>
<dialog color-scheme="{{ settings.color_scheme_popover }}" class="hdt-popover hdt-popover-u hdt-popover-u--no-padding hdt-disclosure hdt-s-text{% if show_country_filter %} hdt-disclosure--country-filter{% endif %}{% if show_currencies %} hdt-disclosure--currencies{% endif %}" id="Popover-{{ id }}Country" scroll-lock>
  <button ref="closeButton" class="hdt-s-text" aria-controls="Popover-{{ id }}Country" aria-label="{{ 'accessibility.close' | t | escape }}">{{ 'icon-close.svg' | inline_asset_content }}</button>
  <span class="hdt-popover-u__top hdt-pe-none">{{- 'icon-u.svg' | inline_asset_content -}}</span>
  <div class="hdt-popover__arrow"></div>
  <div class="hdt-popover__body">
    <div class="hdt-popover__header hdt-s-text{% unless show_country_filter %} md:hdt-hidden{% endunless %}">
      <p class="hdt-text-lg hdt-font-medium md:hdt-hidden">{{ 'localization.country_label' | t }}</p>
      <div id="{{ id }}CountryLabel">
        {%- if show_country_filter -%}
        <hdt-country-filter class="hdt-country-filter hdt-form--move-text hdt-block">
          <div class="hdt-field hdt-field-search">
            <input class="hdt-input hdt-field__input hdt-country-filter__input hdt-input--search" id="{{ id }}country-filter-input" type="search" name="country_filter" value="" placeholder="{{ 'localization.search' | t }}" role="combobox" aria-owns="country-results" aria-controls="country-results" aria-haspopup="listbox" aria-autocomplete="list" autocorrect="off" autocomplete="off" autocapitalize="off" spellcheck="false">
            <label class="hdt-field__label" for="{{ id }}country-filter-input"><span class="hdt-truncate">{{ 'localization.search' | t }}</span></label>
            <button type="reset" class="hdt-country-filter__reset-button hdt-field__button hidden" aria-label="{{ 'localization.search_reset' | t | escape }}" aria-controls="country-results" aria-expanded="false" aria-haspopup="listbox">
              {{- 'icon-reset.svg' | inline_asset_content -}}
            </button>
          </div>
        </hdt-country-filter>
        <div id="{{ id }}country-search-results" class="sr-only" aria-live="polite"></div>
        {%- endif -%}
      </div>
    </div>
    <div class="hdt-popover__inner hdt-scrollbar">
      <localization-form class="hdt-contents"{% if id != 'Global' and localization.available_countries.size > 10 %} get-options{% endif %}{% if id == 'Header' %} on-header{% endif %}>
        <p class="hdt-country-no-results" hidden>{{ 'localization.no_results' | t }}</p>
        {%- form 'localization', id: form_id, class: 'localization-form' -%}
          <div class="hdt-disclosure__list hdt-country-selector__list hdt-grid" id="{{ id }}Country-country-results" role="listbox">
            {%- if id == 'Global' or localization.available_countries.size <= 10 -%}
              {%- if show_popular_countries -%}
              {%- for country in popular_countries -%}
                <button type="submit" name="country_code" class="hdt-disclosure__item hdt-flex hdt-align-center focus-inset-1" role="option" value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} aria-selected="true" {%- endif -%}>
                  <img src="{{ country | image_url: width: 40 }}" alt="{{ country.name | escape }}" width="40" height="40" loading="lazy" class="hdt-disclosure__flag">
                  <span country>{{- country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})</span>
                  {%- if country.iso_code == localization.country.iso_code %}<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>{% endif -%}
                </button>
              {%- endfor -%}
              {%- endif -%}
              {%- for country in localization.available_countries -%}
                {%- liquid
                  if show_popular_countries and popular_countries_iso contains country.iso_code
                    continue
                  endif
                -%}
                <button type="submit" name="country_code" class="hdt-disclosure__item hdt-flex hdt-align-center focus-inset-1" role="option" value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} aria-selected="true" {%- endif -%}>
                  <img src="{{ country | image_url: width: 40 }}" alt="{{ country.name | escape }}" width="40" height="40" loading="lazy" class="hdt-disclosure__flag">
                  <span country>{{- country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})</span>
                  {%- if country.iso_code == localization.country.iso_code %}<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>{% endif -%}
                </button>
              {%- endfor -%}
            {%- endif -%}
          </div>
        {%- endform -%}
      </localization-form>
    </div>
  </div>
</dialog>
</hdt-popover>
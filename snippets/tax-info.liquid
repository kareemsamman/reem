{%- doc -%}
 Intended for use in a block similar to the text block.

  @param {string} [class] - Additional classes to add to the wrapper element
  @param {boolean} [has_discounts_enabled] - whether discounts are enabled

  @example
  {%- render 'tax-info', has_discounts_enabled: false -%}
{%- enddoc -%}

{%- liquid
assign policy_url = settings.policy_url | default: shop.shipping_policy.url
if shop.shipping_policy.body == blank
  if has_discounts_enabled
    assign str_tax = '_without_policy_without_discounts'
  else
    assign str_tax = '_without_policy'
  endif
else
  if has_discounts_enabled
    assign str_tax = '_with_policy_without_discounts_html'
  else
    assign str_tax = '_with_policy_html'
  endif
endif
if cart.duties_included and cart.taxes_included
  assign str_tax = 'cart.duties_and_taxes_included_shipping_at_checkout' | append: str_tax
elsif cart.duties_included == false and cart.taxes_included
  assign str_tax = 'cart.taxes_included_shipping_at_checkout' | append: str_tax
elsif cart.duties_included and cart.taxes_included == false
  assign str_tax = 'cart.duties_included_taxes_at_checkout_shipping_at_checkout' | append: str_tax
elsif cart.duties_included == false and cart.taxes_included == false
  assign str_tax = 'cart.taxes_at_checkout_shipping_at_checkout' | append: str_tax
endif
-%}

<small class="{{ class }} rte">
  {{- str_tax | t: link: policy_url -}}
</small>

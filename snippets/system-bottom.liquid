{%- if settings.show_quick_view or settings.show_quick_add %}<hdt-tmp-quick hidden></hdt-tmp-quick>{% endif -%}
<hdt-append-body not-idle><template>
{%- liquid
if localization.available_countries.size > 1
  render 'country-localization', id: 'Global'
endif
if localization.available_languages.size > 1
  render 'language-localization', id: 'Global'
endif
-%}
{%- if settings.use_inactive_tab and settings.inactive_tab_message != blank -%}
<hdt-inactive-tab class="hdt-contents" config='{ "message": "{{ settings.inactive_tab_message | escape }}", "delay": {{ settings.inactive_tab_delay }} }'></hdt-inactive-tab>
{%- endif -%}
</template></hdt-append-body>
{%- liquid
if template == 'product' and product
  assign target_product = product
elsif cart.items.size > 0
  assign target_product = cart.items[0].product
endif
-%}
{%- capture section_header -%}
  {%- content_for 'block', type: '_section_header', id: 'section-header' -%}
{%- endcapture -%}
{%- capture static_recommendation -%}
  {%- content_for 'block', type: '_product-recommendation', id: 'product-recommendation', target_product: target_product -%}
{%- endcapture -%}

{%- if recommendations.performed? -%}
    {{- section_header -}}
    {{- static_recommendation -}}
{%- else -%}
  <div class="hdt-section-recommened-product hdt-section-spacing hdt-s-gradient" color-scheme="{{ section.settings.color_scheme }}" style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px; --section-pt-xl: {{ section.settings.padding_top_xl }}px; --section-pb-xl: {{ section.settings.padding_bottom_xl }}px;">
    <div class="hdt-container{% if section.settings.full_width %}-xl{% endif %}">
    {{- static_recommendation -}}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:names.recommended_products",
  "tag": "section",
  "class": "hdt-section",
  "limit": 1,
  "enabled_on": {
    "templates": ["product", "cart"]
  },
  "blocks": [
    { "type": "_section_header" },
    { "type": "_product-recommendation" }
  ],
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:settings.make_full_width",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.section_padding"
    },
    {
      "type": "range",
      "id": "padding_top_xl",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:settings.padding_top",
      "default": 60
    },
    {
        "type": "range",
        "id": "padding_bottom_xl",
        "min": 0,
        "max": 200,
        "step": 4,
        "unit": "px",
        "label": "t:settings.padding_bottom",
        "default": 60
    },
    {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 200,
        "step": 4,
        "unit": "px",
        "label": "t:settings.padding_top_mb",
        "default": 40
    },
    {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 200,
        "step": 4,
        "unit": "px",
        "label": "t:settings.padding_bottom_mb",
        "default": 40
    }
  ],
  "presets": [
    {
      "name": "t:names.recommended_products",
      "category": "t:categories.products",
    }
  ]
}
{% endschema %}
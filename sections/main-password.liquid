{{- 'password.css' | asset_url | stylesheet_tag -}}

{%- capture media_background -%}
  {%- render 'bg-media', section: section -%}
{%- endcapture -%}
{%- capture shopify -%}
  <a href="//www.shopify.com" class="hdt-hover-bounce" rel="nofollow" aria-describedby="a11y-new-window-message" aria-label="Shopify">{{ 'icon-shopify-with-text.svg' | inline_asset_content }}</a>
{%- endcapture -%}

<div id="Section-{{ section.id }}" class="hdt-section__main-password hdt-s-gradient" color-scheme="{{ section.settings.color_scheme }}">
  {{- media_background -}}
  <div class="hdt-container-full hdt-container-full--pw">
    <div class="hdt-pw-part hdt-pw-part--top">
      <button aria-controls="Modal-{{ section.id }}" class="hdt-btn--modal-pw hdt-s-text hdt-hover-line-wrap" data-hover="{{ 'password_page.enter_password' | t }}"><i class="hdt-btn--modal-pw-icon">{{ 'icon-locked.svg' | inline_asset_content }}</i><span class="hdt-hover-line">{{ 'password_page.enter_password' | t }}</span></button>
    </div>
    <div class="hdt-pw-part hdt-pw-part--mid">
    {%- if section.settings.logo != blank -%}
        {%- assign logo_width = section.settings.logo_width | default: section.settings.logo.width -%}
        <div class="hdt-pw-logo" style="--logo-width: {{ logo_width }}px;">
            {%- liquid
            assign sizes = logo_width | append: 'px'
            assign widths = '60,100,120,150,200,300,400,500,600,' | append: section.settings.logo.width
            echo section.settings.logo | image_url: width: section.settings.logo.width | image_tag: class: 'header__logo-img', widths: widths, sizes: sizes, preload: true
            -%}
        </div>
    {%- else -%}
        <h1 class="hdt-header__heading hdt-pw-logo hdt-h5 hdt-s-text hdt-uppercase">{{ shop.name }}</h1>
    {%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <div class="hdt-pw-signup hdt-s-text hdt-text-center hdt-rounded-sm">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'title' -%}
                {%- if block.settings.title != blank -%}
                  <p class="hdt-pw-cd-title rte hdt-h4">{{ block.settings.title }}</p>
                {%- endif -%}
              {%- when 'timer' -%}
                {%- capture date %}{{ block.settings.year }}/{{ block.settings.month }}/{{ block.settings.day }} {{ block.settings.hour }}:{{ block.settings.minute }}{% endcapture -%}
                {%- assign date_at_time = date | date: format: 'date_at_time' -%}
                <div class="hdt-pw-countdown-wrap hide-cd-elapsed">
                  <hdt-countdown class="hdt-pw-countdown hdt-countdown--end-{{ block.settings.action_elapsed }} hdt-pw-countdown--{{ block.settings.action_elapsed }}" role="timer" aria-label="{{ 'accessibility.countdown_expired' | t: date_at_time: date_at_time }}" config='{"datetime":"{{ date | date: '%Y-%m-%dT%T' }}", "actionElapsed": "{{ block.settings.action_elapsed }}", "hasZero": true }' {{ block.shopify_attributes }}>
                    <hdt-countdown-item is="days">
                      <div class="hdt-countdown-timer-numbers"><hdt-countdown-number num="0" eff hide-countdown-num>0</hdt-countdown-number><hdt-countdown-number num="0" eff>0</hdt-countdown-number><hdt-countdown-number num="0" eff>0</hdt-countdown-number></div><span part="tmp_num">00</span>
                      <hdt-countdown-text singular="{{ 'countdown_timmer.day' | t | escape }}" class="hdt-countdown__text hdt-grid hdt-text-base hdt-s-text">{{ 'countdown_timmer.day_plural' | t }}</hdt-countdown-text>
                    </hdt-countdown-item>
                    <hdt-countdown-item is="hours">
                      <div class="hdt-countdown-timer-numbers"><hdt-countdown-number limit="3" num="0" eff>0</hdt-countdown-number><hdt-countdown-number num="0" eff>0</hdt-countdown-number></div><span part="tmp_num">00</span>
                      <hdt-countdown-text singular="{{ 'countdown_timmer.hr' | t | escape }}" class="hdt-countdown__text hdt-grid hdt-text-base hdt-s-text">{{ 'countdown_timmer.hr_plural' | t }}</hdt-countdown-text>
                    </hdt-countdown-item>
                    <hdt-countdown-item is="minutes" numbers="00">
                      <div class="hdt-countdown-timer-numbers"><hdt-countdown-number num="0" limit="6" eff>0</hdt-countdown-number><hdt-countdown-number num="0" eff>0</hdt-countdown-number></div><span part="tmp_num">00</span>
                      <hdt-countdown-text singular="{{ 'countdown_timmer.min' | t | escape }}" class="hdt-countdown__text hdt-grid hdt-text-base hdt-s-text">{{ 'countdown_timmer.min_plural' | t }}</hdt-countdown-text>
                    </hdt-countdown-item>
                    <hdt-countdown-item is="seconds" numbers="00">
                      <div class="hdt-countdown-timer-numbers"><hdt-countdown-number num="0" limit="6" eff>0</hdt-countdown-number><hdt-countdown-number num="0" eff>0</hdt-countdown-number></div><span part="tmp_num">00</span>
                      <hdt-countdown-text singular="{{ 'countdown_timmer.sec' | t | escape }}" class="hdt-countdown__text hdt-grid hdt-text-base hdt-s-text">{{ 'countdown_timmer.sec_plural' | t }}</hdt-countdown-text>
                    </hdt-countdown-item>
                  </hdt-countdown>
                  {%- if block.settings.action_elapsed == 'hide_cd_show_mess' %}<div class="hdt-countdown-mess rte hdt-s-text hdt-text-lg hdt-uppercase" hidden>{{ block.settings.message }}</div>{% endif -%}
                </div>
              {%- when 'newsletter' -%}
                <div class="hdt-pw-newsletter" {{ block.shopify_attributes }}>
                  {%- form 'customer', class: 'hdt-pw-newsletter-form hdt-form--move-text hdt-s-text' -%}
                    <input type="hidden" name="contact[tags]" value="newsletter">
                    <div class="hdt-form-row hdt-row-grid hdt-grid-cols-1">
                      <div class="hdt-field hdt-field--input-btn-group hdt-field-gr-has-btn{% if form.errors %} hdt-field--with-error{% endif %}">
                        <input type="email" name="contact[email]" id="newsletter--{{ block.id }}" class="hdt-input hdt-field__input hdt-input--email" value="{{ form.email }}" aria-required="true" autocomplete="email" autocorrect="off" autocapitalize="off"{% if form.errors %} autofocus aria-invalid="true" aria-describedby="newsletter-error--{{ block.id }}"{% endif %} placeholder="{{ 'newsletter.label' | t }}">
                        <label for="newsletter--{{ block.id }}" class="hdt-field__label sr-only"><span class="hdt-truncate">{{ 'newsletter.label' | t | escape }}</span></label>
                        <button circle-bg-wrap type="submit" data-hover="{{ 'password_page.newsletter_submit' | t }}" class="hdt-btn hdt-btn-solid hdt-btn--size-s hdt-btn-full-width hdt-text-sm hdt-uppercase">
                          <span>{{- 'password_page.newsletter_submit' | t -}}</span>
                          <hdt-circle-bg mousemove></hdt-circle-bg>
                        </button>
                      </div>
                      {%- if form.errors -%}
                          <small id="newsletter-error--{{ block.id }}" class="hdt-form-field__msg hdt-s-text">{{ 'icon-error.svg' | inline_asset_content }} <span>{{- form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email -}}</span></small>
                        {%- endif -%}
                    </div>
                  {%- endform -%}
                </div>
              {%- when 'password_msg' -%}
                {%- if shop.password_message != blank -%}
                  <p class="hdt-password__shop-message hdt-rounded-sm">{{ shop.password_message }}</p>
                {%- endif -%}
            {%- endcase -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
      <span class="hdt-pw-ask-owner hdt-text-lg hdt-s-text">{{ 'password_page.ask_owner' | t }} <a class="hdt-link-underline hdt-font-medium hdt-no-print" href="/admin"><span>{{ 'password_page.login_here' | t }}</span></a></span>
    </div>
    <div class="hdt-pw-part hdt-pw-part--bottom">
      <span class="hdt-pw-power-by hdt-s-text hdt-text-center">{{ 'password_page.powered_by_shopify_html' | t: shopify: shopify }}</span>
      {%- if section.settings.show_social_links -%}
        <div class="hdt-so-links-wrap">
            {%- render 'social-links' -%}
        </div>
      {%- endif -%}
    </div>

    {%- assign form_password_error = false -%}
    {%- capture form_password -%}
      {%- form 'storefront_password', class: 'hdt-login-pw hdt-form--move-text' -%}
        {%- liquid
        if form.errors
          assign form_password_error = true
        endif
        -%}
        <div class="hdt-form-row hdt-row-grid hdt-grid-cols-1">
          <div class="hdt-field hdt-field--input-btn-group hdt-field-gr-has-btn{% if form_password_error %} hdt-field--with-error{% endif %}">
            <input type="password" name="password" id="Password-{{ section.id }}" class="hdt-input hdt-field__input hdt-input--password" autocomplete="current-password"{% if form_password_error %} aria-invalid="true" aria-describedby="PasswordLoginForm-password-error-{{ section.id }}"{% endif %} placeholder="{{ 'password_page.login_form_password_label' | t }}">
            <label for="Password-{{ section.id }}" class="hdt-field__label sr-only">{{ 'password_page.login_form_password_label' | t | escape }}</label>
            <button circle-bg-wrap type="submit" class="hdt-btn hdt-btn-solid hdt-btn--size-s hdt-text-sm hdt-uppercase">
              <span>{{- 'password_page.login_form_submit' | t -}}</span>
              <hdt-circle-bg mousemove></hdt-circle-bg>
            </button>
          </div>
          {%- if form_password_error -%}
            <small id="PasswordLoginForm-password-error-{{ section.id }}" class="hdt-form-field__msg hdt-s-text">{{ 'icon-error.svg' | inline_asset_content }} <span class="sr-only">{{ 'accessibility.error' | t }}</span><span>{{ 'password_page.login_form_error' | t }}</span></small>
          {%- endif -%}
        </div>
      {%- endform -%}
    {%- endcapture -%}

      <hdt-modal class="hdt-contents" initia-focus='[type="password"]'>
        <dialog id="Modal-{{ section.id }}" class="hdt-dialog hdt-modal hdt-modal--pw hdt-s-text hdt-text-center" scroll-lock{% if form_password_error %} open{% endif %}>
          <button ref="closeButton" class="hdt-s-text" aria-controls="Modal-{{ section.id }}" aria-label="{{ 'accessibility.close' | t | escape }}">{{ 'icon-close.svg' | inline_asset_content }}</button>
          <div class="hdt-modal-inner hdt-rounded-sm">
            <div class="hdt-modal__header">
              <h2 class="hdt-heading hdt-heading--pw hdt-h4">{{ 'password_page.login_form_heading' | t }}</h2>
            </div>
            <div class="hdt-modal__inner hdt-scrollbar">
              {{- form_password -}}
            </div>
          </div>
        </dialog>
      </hdt-modal>
  </div>
</div>

{% schema %}
{
  "name": "t:names.password",
  "class": "hdt-section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:settings.logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 30,
      "max": 300,
      "step": 5,
      "default": 60,
      "unit": "px",
      "label": "t:settings.logo_width"
    },
    {
      "type": "checkbox",
      "id": "show_social_links",
      "label": "t:settings.social_media_links",
      "default": true
    },
    {
      "type": "header",
      "content": "t:content.background"
    },
    {
      "type": "select",
      "id": "background_type",
      "label": "t:settings.background_type",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "color",
          "label": "t:options.color"
        },
        {
          "value": "image",
          "label": "t:options.image"
        }
      ],
      "default": "none"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "t:settings.background",
      "visible_if": "{{ section.settings.background_type == 'color' }}"
    },
    {
      "type": "color_background",
      "id": "bg_gradient",
      "label": "t:settings.background_gradient",
      "info": "t:info.background_gradient",
      "visible_if": "{{ section.settings.background_type == 'color' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "t:settings.background_image",
      "visible_if": "{{ section.settings.background_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image_mb",
      "label": "t:settings.background_image_mb",
      "visible_if": "{{ section.settings.background_type == 'image' }}"
    },
    {
      "type": "checkbox",
      "id": "background_overlay",
      "label": "t:settings.background_overlay",
      "visible_if": "{{ section.settings.background_type == 'image' }}",
      "default": false
    },
    {
      "type": "color",
      "id": "color_overlay",
      "label": "t:settings.color_overlay",
      "default": "#0000001a",
      "alpha": true,
      "visible_if": "{{ section.settings.background_overlay == true and section.settings.background_type == 'image' }}"
    },
    {
      "type": "select",
      "id": "overlay_style",
      "label": "t:settings.overlay_type",
      "options": [
        {
          "value": "solid",
          "label": "t:options.solid"
        },
        {
          "value": "gradient",
          "label": "t:options.gradient"
        }
      ],
      "default": "solid",
      "visible_if": "{{ section.settings.background_overlay == true and section.settings.background_type == 'image'}}"
    },
    {
      "type": "select",
      "id": "gradient_direction",
      "label": "t:settings.gradient_direction",
      "options": [
        {
          "value": "to top",
          "label": "t:options.up"
        },
        {
          "value": "to bottom",
          "label": "t:options.down"
        }
      ],
      "default": "to top",
      "visible_if": "{{ section.settings.background_overlay == true and section.settings.overlay_style == 'gradient' and section.settings.background_type == 'image' }}"
    }
  ],
  "blocks": [
    {
      "type": "title",
      "name": "t:names.heading",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "t:settings.heading_text",
          "default": "t:text_defaults.opening_soon"
        },
      ]
    },
    {
      "type": "timer",
      "name": "t:names.countdown",
      "limit": 1,
      "settings": [
        {
          "type": "header",
          "content": "t:content.timer",
          "info": "t:info.countdown_info"
        },
        {
          "type": "paragraph",
          "content": "t:content.timezone_help"
        },
        {
          "type": "range",
          "id": "year",
          "min": 2026,
          "max": 2050,
          "step": 1,
          "label": "t:settings.year",
          "default": 2028
        },
        {
          "type": "range",
          "id": "month",
          "min": 1,
          "max": 12,
          "step": 1,
          "label": "t:settings.month",
          "default": 4
        },
        {
          "type": "range",
          "id": "day",
          "min": 1,
          "max": 31,
          "step": 1,
          "label": "t:settings.day",
          "default": 19
        },
        {
          "type": "range",
          "id": "hour",
          "min": 0,
          "max": 23,
          "step": 1,
          "label": "t:settings.hour",
          "default": 0
        },
        {
          "type": "range",
          "id": "minute",
          "min": 0,
          "max": 59,
          "step": 1,
          "label": "t:settings.minute",
          "default": 0
        },
        {
          "type": "radio",
          "id": "action_elapsed",
          "options": [
            {
              "value": "zero",
              "label": "t:options.leave_timer_at_zero"
            },
            {
              "value": "hide",
              "label": "t:options.hide_timer"
            },
            {
              "value": "hide_cd_show_mess",
              "label": "t:options.hide_cd_show_mess"
            }
          ],
          "default": "zero",
          "label": "t:settings.action_elapsed"
        },
        {
          "type": "inline_richtext",
          "id": "message",
          "label": "t:settings.timer_end_message",
          "default": "t:text_defaults.timer_end_message",
          "visible_if": "{{ block.settings.action_elapsed == 'hide_cd_show_mess' }}"
        },
      ]
    },
    {
      "type": "newsletter",
      "name": "t:names.newsletter",
      "limit": 1
    },
    {
      "type": "password_msg",
      "name": "t:names.password_msg",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "t:content.password_msg"
        },
      ]
    },
  ],
 "default": {
    "blocks": [
      {
        "type": "timer",
      },
      {
        "type": "newsletter",
      },
      {
        "type": "password_msg",
      },
    ]
  }
}
{% endschema %} 
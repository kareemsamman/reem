<div color-scheme="{{ section.settings.color_scheme }}" id="Section-{{ section.id }}" class="hdt-section__scrolling-content hdt-section-spacing hdt-relative hdt-s-gradient{% if section.settings.two_end_fade %} hdt-two-end-fade{% endif %}" style="--fs:{{ section.settings.font_size }}px; --fs-lg:{{ section.settings.font_size_lg }}px;--gap-item-lg: {{ section.settings.gap_content_lg }}px;--gap-item: {{ section.settings.gap_content }}px; --section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px; --section-pt-xl: {{ section.settings.padding_top_xl }}px; --section-pb-xl: {{ section.settings.padding_bottom_xl }}px">
    {%- if section.blocks.size > 0 -%}
    <hdt-marquee speed-factor="{{ section.settings.speed }}" direction="{{ section.settings.dir }}"{% if section.settings.pause_on_hover %} pausable{% endif %} class="hdt-marquee">
        <div class="hdt-marquee-inner"><div class="hdt-marquee-item hdt-inline-flex hdt-align-center hdt-s-text{% if section.settings.uppercase %} hdt-uppercase{% endif %}">{% content_for 'blocks' %}</div></div>
    </hdt-marquee>
    {%- endif -%}
</div>

{% schema %}
{
  "name": "t:names.scrolling_content",
  "tag": "section",
  "class": "hdt-section",
  "enabled_on": {
    "templates": ["*"],
    "groups": ["footer"]
  },
  "blocks":[{"type": "_marquee_mess"}, {"type": "_marquee_icon"}],
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "min": 0.1,
      "max": 1,
      "step": 0.1,
      "unit": "sec",
      "label": "t:settings.speed",
      "default": 0.3
    },
    {
      "type": "select",
      "id": "dir",
      "options": [
        {
          "value": "rtl",
          "label": "t:options.rtl"
        },
        {
          "value": "ltr",
          "label": "t:options.ltr"
        }
      ],
      "default": "rtl",
      "label": "t:settings.direction"
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "t:settings.pause_on_hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "uppercase",
      "label": "t:settings.text_uppercase",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "two_end_fade",
      "label": "t:settings.two_end_fade",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.typography"
    },
    {
      "type": "select",
      "id": "text_font",
      "options": [
        {
          "value": "body",
          "label": "t:options.body"
        },
        {
          "value": "heading",
          "label": "t:options.heading"
        }
      ],
      "default": "body",
      "label": "t:settings.text_font"
    },
    {
      "type": "range",
      "id": "font_size_lg",
      "min": 10,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:settings.font_size",
      "default": 14
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "t:settings.font_size_mb",
      "default": 12
    },
    {
      "type": "header",
      "content": "t:content.spacing"
    },
    {
      "type": "range",
      "id": "gap_content_lg",
      "min": 10,
      "max": 210,
      "step": 2,
      "unit": "px",
      "label": "t:settings.gap_content_lg",
      "default": 20
    },
    {
      "type": "range",
      "id": "gap_content",
      "min": 10,
      "max": 210,
      "step": 2,
      "unit": "px",
      "label": "t:settings.gap_content",
      "default": 16
    },
    {
      "type": "header",
      "content": "t:content.section_padding"
    },
    {
      "type": "range",
      "id": "padding_top_xl",
      "min": 4,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:settings.padding_top",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom_xl",
      "min": 4,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:settings.padding_bottom",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 4,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:settings.padding_top_mb",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 4,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:settings.padding_bottom_mb",
      "default": 12
    }
  ],
  "presets": [ 
    {
      "name": "t:names.scrolling_content",
      "category": "t:categories.banners",
      "blocks": [
        {
            "type": "_marquee_mess"
        }
      ]
    }
  ]
}
{% endschema %}

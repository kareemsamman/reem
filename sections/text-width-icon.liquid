<!--Text width icon-->
{%- liquid
    if section.settings.icon_pos == 'top'
        assign at_most = 3
    else
        assign at_most = 2
    endif
    assign size_half = section.blocks.size | divided_by: 2.0 | round | at_most: at_most | at_least: 2
    assign odd = section.blocks.size | minus: size_half | modulo: 2
    
   if settings.sections_reveal_on_scroll and section.settings.reveal_on_scroll
        assign reveal = 'reveal'
    else
        assign reveal = ''
    endif
-%}
<div {% if reveal == 'reveal' %}reveal-on-scroll{% endif %} color-scheme="{{ section.settings.color_scheme }}" id="Section-{{ section.id }}" class="hdt-text--with-icon hdt-layout--{{ section.settings.layout_style }} hdt-s-gradient hdt-section-spacing" style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px; --section-pt-xl: {{ section.settings.padding_top_xl }}px; --section-pb-xl: {{ section.settings.padding_bottom_xl }}px">
    <div class="hdt-container{% if section.settings.full_width %}-xl{% endif %}">
        {%- if section.settings.heading != blank and section.settings.text -%}
            <div class="hdt-section-title {% if section.settings.align_header %}hdt-text-center{% endif %}">
                <div class="hdt-inner-section-title"{% if section.settings.custom_width %} style="--title-custom-width: {{ section.settings.maximum_width }}px"{% endif %}>
                    {%- if section.settings.heading != blank -%}
                        <{{ section.settings.heading_section_tag }} {{ reveal }} class="hdt-{{ section.settings.heading_section_size }} hdt-heading hdt-theme-block hdt-heading-block">{{ section.settings.heading }}</{{ section.settings.heading_section_tag }}>
                    {%- endif -%}
                    {%- if section.settings.text != blank -%}
                        <div {{ reveal }} class="hdt-theme-block hdt-text-block rte hdt-text-{{ section.settings.text_size }}">{{ section.settings.text }}</div>
                    {%- endif -%}
                </div>
            </div>
        {%- endif -%}
        <div class="hdt-iconbox-wrap hdt-rounded"{% if section.settings.inherit_color_scheme == false and section.settings.layout_style == 'card' %} color-scheme="{{ section.settings.color_scheme_card }}"{% endif %}>
            <hdt-slider eff2 id="Slider-{{ section.id }}" -autoheight data-blocks_size="{{ section.blocks.size }}" data-odd="{{ odd }}" class="hdt-slider hdt-con-reveal--vertical hdt-slider__active-{{ section.settings.swipe_on_mobile }} md:hdt-slider__active-false xl:hdt-slider__active-false hdt-slide-spacing-x xl:hdt-slides-{{ section.blocks.size }} md:hdt-slides-{{ size_half }} hdt-slides-1{% if section.settings.swipe_on_mobile %} hdt-swipe-on-mobile hdt-slide_autoplay{% endif %}" config='{ "autoHeight": false, "active": {{ section.settings.swipe_on_mobile }}, "loop": false, "fade": false, "slidesToScroll": 1, "breakpoints": { "(min-width: 768px)": {  "active": false } } }' autoplay="3000" style="--hdt-remaining: 3000ms">
                <div class="hdt-slider__viewport">
                    <div class="hdt-slider__container  md:hdt-flex-wrap md:hdt-justify-center{% unless section.settings.swipe_on_mobile %} hdt-flex-wrap hdt-justify-center{% endunless %}">
                        {%- for block in section.blocks -%}
                            <div class="hdt-icon-item hdt-slider__slide" {{ reveal }} {{ block.shopify_attributes }}>
                                <div class="hdt-icon-item-inner hdt-icon--pos-{{ section.settings.icon_pos }} hdt-text-center{% if section.settings.icon_pos == 'top'%} md:hdt-text-center{% else %} md:hdt-text-start{% endif %}">
                                    {%- if block.settings.image_icon != blank or block.settings.custom_icon != blank or block.settings.icon != 'none'-%}
                                        <div {{ reveal }} class="hdt-icon-wrap hdt-icon__type-{{ section.settings.icon_type }}" style="{% if block.settings.image_icon != blank %}{% assign icon_w_md = block.settings.icon_h_md | times: block.settings.image_icon.aspect_ratio %}{% assign icon_w = block.settings.icon_h | times: block.settings.image_icon.aspect_ratio %}--icon-mw-md: {{ icon_w_md }}px;--icon-mw: {{ icon_w}}px;{% endif %}--icon-h-md: {{ block.settings.icon_h_md }}px;--icon-h: {{ block.settings.icon_h }}px">
                                            {%- liquid
                                                if block.settings.image_icon != blank
                                                assign icon_w_md = icon_w_md | ceil
                                                assign icon_w = icon_w | ceil
                                                assign icon_w_md_2x = icon_w_md | times: 2
                                                assign icon_w_2x = icon_w | times: 2
                                                assign widths = icon_w_md_2x | append: ', ' | append: icon_w  | append: ', ' | append: icon_w_2x | append: ', ' | append: icon_w
                                                assign sizes = '(min-width: 768px) 22px, 11px' | replace_first: '22', icon_w_md   | replace_first: '11', icon_w
                                                assign max_w = icon_w_2x | at_least: icon_w_md_2x
                                                echo block.settings.image_icon | image_url: width: max_w | image_tag: widths: widths, sizes: sizes
                                                elsif block.settings.custom_icon != blank
                                                echo block.settings.custom_icon
                                                else
                                                echo 'icon-' | append: block.settings.icon | append: '.svg' | inline_asset_content
                                                endif
                                            -%}
                                        </div>
                                    {%- endif -%}
                                    <div class="hdt-icon-box-content">
                                        {%- if block.settings.heading != blank -%}
                                            <{{ section.settings.heading_tag }} {{ reveal }} id="block-{{ block.id }}" class="hdt-heading hdt-text-{{ section.settings.heading_size }}{% if section.settings.heading_uppercase %} hdt-uppercase{% endif %}">
                                                {{- block.settings.heading -}}
                                            </{{ section.settings.heading_tag }}>
                                        {%- endif -%}
                                        {%- if block.settings.description != blank -%}   
                                            <div {{ reveal }} id="block-{{ block.id }}" class="hdt-text-{{ section.settings.description_size }} hdt-s-text rte">
                                                {{- block.settings.description -}}
                                            </div>
                                        {%- endif -%}
                                        {%- if block.settings.button_link != blank -%}
                                            <a {{ reveal }} {% if block.settings.button_link %} href="{{ block.settings.button_link }}"{% else %} role="link" aria-disabled="true"{% endif %} class="{% unless section.settings.button_style == 'link' %}hdt-btn{% endunless %} hdt-btn--inner hdt-btn-{{ section.settings.button_style }} hdt-btn--size-{{ section.settings.button_size }}">
                                                <span circle-bg-wrap class="hdt-inner-btn">
                                                    {{- block.settings.button_label -}}
                                                    {%- if section.settings.button_style == 'link' -%}
                                                        {{- 'icon-slide.svg' | inline_asset_content -}}
                                                    {%- else -%}
                                                        <hdt-circle-bg mousemove></hdt-circle-bg>
                                                    {%- endif -%}
                                                </span>
                                            </a>
                                        {%- endif -%}
                                    </div>
                                </div>
                            </div>
                        {%- endfor -%}
                    </div>
                </div>
                <hdt-slider-dots aria-controls="Slider-{{ section.id }}" class="hdt-slider-dots hdt-slider-dots__progressbar" class="no-js-hidden" hidden></hdt-slider-dots>
            </hdt-slider>
        </div>
    </div>
</div>

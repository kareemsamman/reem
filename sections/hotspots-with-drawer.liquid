{%- liquid
  if section.index == 1
    assign fetch_priority = 'high'
    assign loading = 'eager'
  else
    assign fetch_priority = 'auto'
    assign loading = 'lazy'
  endif
  assign class_object_mb = 'hdt-w-full'
  assign object_pos = section.settings.image_mb.presentation.focal_point
  if settings.sections_reveal_on_scroll and section.settings.reveal_on_scroll
      assign reveal = 'reveal'
  else
      assign reveal = ''
  endif
-%}
{%- if section.settings.header_inside -%}
  {%- style -%}
  @media (min-width: 1024px) {
    #Section-{{ section.id }} .hdt-hotspots-with-drawer__header {
      {%- assign scheme = section.settings.color_scheme_inside -%}
      --color-text-rgb: {{ scheme.settings.text.rgb }}; --color-btn-primary-rgb: {{ scheme.settings.button_primary.rgb }}; --color-btn-secondary-rgb: {{ scheme.settings.button_secondary.rgb }}; --color-btn-primary-hover: rgba({{ scheme.settings.button_primary_hover.rgba }}); --color-btn-secondary-hover: rgba({{ scheme.settings.button_secondary_hover.rgba }});
    }
  }
  {%- endstyle -%}
{%- endif -%}
{%- capture sizes -%}
{%- if section.settings.full_width -%}
100vw
{%- else -%}
(min-width: {{ settings.page_width }}px) min({{ settings.page_width }}px, 100vw), 100vw
{%- endif -%}
{%- endcapture -%}

<hdt-hotspots-with-drawer color-scheme="{{ section.settings.color_scheme }}" id="Section-{{ section.id }}" class="hdt-block hdt-hotspots-with-drawer{% if section.settings.glassy_hotspot_content %} hdt-hotspots-with-drawer--glassy{% endif %}{% if section.settings.header_inside %} hdt-hotspots-with-drawer--inside hdt-hotspots-with-drawer--inside-{{ section.settings.header_pos }}{% else %} hdt-hotspots-with-drawer--outside{% endif %} hdt-section-spacing hdt-s-gradient" style="{% if object_pos != blank %}{% assign class_object_mb = 'hdt-object-pos-mb hdt-w-full' %}--object-pos-mb: {{ object_pos }};{% endif %}--color-overlay-opacity: {{ section.settings.overlay_opacity }}%;--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px; --section-pt-xl: {{ section.settings.padding_top_xl }}px; --hotspot-main-color: {{ section.settings.hotspots_primary_color }}; --hotspot-second-color: {{ section.settings.hotspots_secondary_color }}; --section-pb-xl: {{ section.settings.padding_bottom_xl }}px;">
  <div class="hdt-container{% if section.settings.full_width %}-xl hdt-container-spacing{% endif %}" {% if settings.sections_reveal_on_scroll and section.settings.reveal_on_scroll %} reveal-on-scroll{% endif %}>
    <div class="hdt-hotspots-with-drawer__wrap hdt-grid">
      <div color-scheme class="hdt-hotspots-with-drawer__header hdt-section-title{% if section.settings.header_inside and section.settings.heading_bottom_fade %} hdt-section-title--b-fade{% else %} hdt-text-{{ section.settings.header_align }}{% endif %}" style="--max-width: {{ section.settings.max_width | plus: 20 }}px; --place-self: {{ section.settings.header_pos }};" {{ reveal }}>
        <div class="hdt-title-content">
          {%- if section.settings.heading != blank %}<{{ section.settings.heading_tag }} {{ reveal }} class="hdt-theme-block hdt-heading-block hdt-{{ section.settings.heading_size }} hdt-heading{% if section.settings.uppercase %} hdt-uppercase{% endif %}">{{ section.settings.heading }}</{{ section.settings.heading_tag }}>{% endif -%}
            <div {{ reveal }} class="hdt-theme-block hdt-text-block rte hdt-s-text hdt-text-{{ section.settings.text_size }}{% if section.settings.hide_mobile %} hdt-hidden md:hdt-block{% endif %}">
                {{- section.settings.text -}}
            </div>
        </div>
        {%- if section.settings.button_link != blank -%}
            <a {{ reveal }} class="{% unless section.settings.button_style == 'link' %}hdt-btn{% endunless %} hdt-btn--inner hdt-btn-{{ section.settings.button_style }} hdt-btn--size-{{ section.settings.button_size }}{% if section.settings.icon_button %} hdt-btn--with-icon{% endif %}{% if section.settings.btn_uppercase and settings.btn_case != 'uppercase' %} hdt-uppercase{% endif %}" {% if section.settings.button_link != blank %} href="{{ section.settings.button_link }}"{% else %} role="link" aria-disabled="true"{% endif %}{% if section.settings.open_in_new_tab %} target="_blank" aria-describedby="a11y-new-window-message" rel="noopener noreferrer"{% endif %}>
              <span circle-bg-wrap class="hdt-inner-btn">
                {{- section.settings.button_label -}}
                {%- if section.settings.icon_button -%}{{ 'icon-' | append: section.settings.icon_btn_custom | append: '.svg' | inline_asset_content }}{%- endif -%}
                {%- if section.settings.button_style == 'link' -%}
                    {{- 'icon-slide.svg' | inline_asset_content -}}
                {%- else -%}
                  <hdt-circle-bg mousemove></hdt-circle-bg>
                {%- endif -%}
              </span>
            </a>
        {%- endif -%}
      </div>
      {%- liquid
        if section.settings.image != blank
          assign widths = '400,600,800,1000,1200,1400,1600,1800,2000,2200,2400,2600,2800,3000,3200,' | append: section.settings.image.width
          echo '<picture class="hdt-hotspots-with-drawer__image">'
          if section.settings.image_mb != blank and section.settings.image_mb != section.settings.image
            assign append_w_mb = section.settings.image_mb.width | default: 1000
            assign widths_mb = '200,400,600,800,1000,' | append: append_w_mb
            assign srcset = section.settings.image_mb | image_url: width: section.settings.image_mb.width | image_tag: widths: widths_mb, alt: null | split: 'srcset="' | last
            unless srcset contains 'src='
              echo '<source media="(max-width: 767px)" srcset="' | append: srcset | replace_first: 'style=', 'data-none='
            endunless
          endif
          if section.settings.full_width
            assign sizes = '100vw'
          else
            assign sizes = '(min-width:' | append: settings.page_width | append: 'px) ' | append: settings.page_width | append: 'px, (min-width: 1024px) calc(100vw - 60px)'
          endif
          echo section.settings.image | image_url: width: section.settings.image.width | image_tag: fetchpriority: fetch_priority, loading: loading, sizes: sizes, class: class_object_mb, widths: widths, is: 'img-effect', eff: section.settings.image_behavior
          echo '</picture>'
        else
          echo '<div class="hdt-hotspots-with-drawer__image">'
          echo 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg hdt-placeholder'
          echo '</div>'
        endif
      -%}
      <div color-scheme="{{ section.settings.color_scheme_inside }}" class="hdt-hotspots-with-drawer__hotspos-wrap hdt-relative hdt-rounded-lg hdt-rounded-f">
        {%- for block in section.blocks -%}
          {%- liquid
            assign hotspot_heading = block.settings.product.title | default: block.settings.heading
          -%}
          <button class="hdt-hotspots-with-drawer__hotspot" aria-label="{{ 'accessibility.open_hotspot' | t: heading: hotspot_heading | escape }}" aria-expanded="false" aria-controls="Drawer-{{ section.id }}" data-index="{{ forloop.index0 }}" style="--x-pos:{{ block.settings.x_pos }}%; --y-pos:{{ block.settings.y_pos }}%;--x-pos-mb:{{ block.settings.x_pos_mb }}%; --y-pos-mb:{{ block.settings.y_pos_mb }}%;" {{ block.shopify_attributes }}>
            <span class="hdt-hotspots-with-drawer__sonar hdt-pe-none"></span>
            <span class="hdt-hotspots-with-drawer__dot hdt-pe-none">
              {{- 'icon-hotspot-' | append: section.settings.hotspot_icon | append: '.svg' | inline_asset_content -}}
            </span>
          </button>
          {%- if block.type == 'image_with_text' -%}
            {%- if block.settings.heading != '' -%}
              <hdt-floating class="hdt-floating hdt-floating--hs-drawer">
                <p class="hdt-h6 hdt-hs-drawer-heading">{{ block.settings.heading | escape }}</p>
                <div class="hdt-floating__arrow hdt-floating__arrow--hs-drawer"></div>
              </hdt-floating>
            {%- endif -%}
          {%- elsif block.settings.product != blank -%}
            <hdt-floating class="hdt-floating hdt-floating--hs-drawer hdt-floating--hs-product">
              <div class="hdt-hotspot-media hdt-relative hdt-oh">
                {%- liquid
                  assign image = block.settings.product.featured_image | default: settings.placeholder_img
                  assign sizes = '55px'
                  assign width = 55
                  assign widths =  '55,110,' | append: image.width
                  if image != blank
                    echo image | image_url: width: width | image_tag: widths: widths, sizes: sizes, class: 'hdt-w-full hdt-h-auto'
                  else
                  capture current
                  cycle 1, 2, 3
                  endcapture
                  echo 'product-apparel-' | append: current | placeholder_svg_tag: 'hdt-w-full hdt-h-auto'
                  endif
                -%}
              </div>
              <div class="hdt-hotspot-content">
                {%- if block.settings.product != blank %}<a href="{{ block.settings.product.url }}" class="hdt-text-base hdt-hs-drawer-heading">{{ block.settings.product.title }}</a>{% else %}<p class="hdt-h6 hdt-hs-drawer-heading">{{ 'onboarding.product_title' | t }}</p>{% endif -%}
                {%- render 'item-price', product: block.settings.product, price_class: 'hdt-text-base hdt-font-semibold' -%}
              </div>
              <div class="hdt-floating__arrow hdt-floating__arrow--hs-drawer"></div>
            </hdt-floating>
          {%- endif -%}
        {%- endfor -%}
        <hdt-lazy-replace><template>
        <hdt-drawer color-scheme="{{ section.settings.drawer_color_scheme }}" class="hdt-contents">
          <dialog id="Drawer-{{ section.id }}" ref="dialog" class="hdt-drawer hdt-drawer--hotspots hdt-dialog hdt-s-text{% if settings.drawer_indent %} hdt-drawer--indent{% endif %}{% if settings.drawer_blur %} hdt-drawer--blur{% endif %}" pos="right" scroll-lock>
            <div class="hdt-drawer_wrapper">
              <div class="hdt-drawer__inner">
                <div class="hdt-hotspots-with-drawer__sidepanel">
                  <button class="hdt-hotspots-with-drawer__close" aria-controls="Drawer-{{ section.id }}" aria-label="{{ 'accessibility.close' | t | escape }}">{{ 'icon-close.svg' | inline_asset_content }}</button>
                  <div class="hdt-slider-hs-drawer-wrap">
                    <hdt-slider id="Slider-{{ section.id }}" config='{ "watchDrag": false, "loop": true, "watchResize": true, "fade": true }' class="hdt-slider hdt-hotspots-with-drawer__items">
                      <div class="hdt-slider__viewport">
                        <div class="hdt-slider__container">
                          {%- for block in section.blocks -%}
                            {%- case block.type -%}
                              {%- when 'image_with_text' -%}
                                {%- liquid
                                  assign image = block.settings.image
                                -%}
                              {%- else -%}
                                {%- liquid
                                  assign image = block.settings.product.featured_image | default: settings.placeholder_img
                                -%}
                            {%- endcase -%}
                            <div class="hdt-slider__slide hdt-hotspots-with-drawer__item hdt-hotspots-with-drawer__item--{{ block.type }}{% unless image != blank %} hdt-hotspots-with-drawer__no-media{% endunless %}" data-index="{{ forloop.index0 }}">
                              <div class="hdt-scroll-content hdt-scrollbar hdt-hotspot-with-drawer-detail">
                                {%- if image != blank -%}
                                <div class="hdt-hotspots-with-drawer__media">
                                  {%- liquid
                                  assign widths = '300,400,500,600,800,1000,1100,' | append: image.width
                                  echo image | image_url: width: image.width | image_tag: widths: widths, loading: 'lazy', sizes: '(max-width: 767px) 90vw, 500px'
                                  -%}
                                </div>
                                {%- endif -%}
                                <div class="hdt-hotspots-with-drawer__content">
                                  {%- if block.type == 'image_with_text' -%}
                                    {%- if block.settings.heading != blank -%}<p class="hdt-h5 hdt-hs-drawer-heading">{{ block.settings.heading | escape }}</p>{%- endif -%}
                                    {%- if block.settings.description != blank -%}<div class="rte">{{ block.settings.description }}</div>{%- endif -%}
                                  {%- else -%}
                                    <div class="hdt-product__info-container">
                                      {%- if block.settings.product != blank -%}
                                          {%- liquid
                                            assign product = block.settings.product | default: product
                                          -%}
                                          {%- render 'badges', product: product, class: 'hdt-product-info__item--badges hdt-product-info__item hdt-product-info__item--box-top hdt-product-info__item--box-bottom' -%}
                                          {%- if block.settings.show_vendor or block.settings.show_rating -%}
                                            <div class="hdt-product-info__item hdt-product-info__item--text-box hdt-product-info-group_vendor-rate">
                                              {%- if block.settings.show_vendor -%}
                                                {%- liquid
                                                  assign vendor = product.vendor
                                                  assign vendor_handle = vendor | handle
                                                  if settings.use_url_collection_vendor and collections[vendor_handle] != blank
                                                    assign vendor_url = collections[vendor_handle].url
                                                  else
                                                    assign vendor_url = vendor | url_for_vendor
                                                  endif
                                                -%}
                                                {%- if vendor != blank -%}
                                                  <div class="hdt-product__vendor hdt-product-info__item--text hdt-text-xs hdt-font-semibold hdt-s-text" data-type="vendor" {{ block.shopify_attributes }}>
                                                    <span class="sr-only">{{- 'accessibility.vendor' | t -}}</span><a href="{{ vendor_url }}" class="hdt-main-product__vendor">{{ vendor | escape }}</a>
                                                  </div>
                                                {%- endif -%}
                                              {%- endif -%}
                                              {%- if block.settings.show_rating -%}
                                                {%- if product.metafields.reviews.rating.value != blank -%}
                                                {% liquid
                                                    assign rating_decimal = 0
                                                    assign decimal = product.metafields.reviews.rating.value.rating | modulo: 1
                                                    if decimal >= 0.3 and decimal <= 0.7
                                                    assign rating_decimal = 0.5
                                                    elsif decimal > 0.7
                                                    assign rating_decimal = 1
                                                    endif
                                                %}
                                                <div class="hdt-rating" role="image" aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: product.metafields.reviews.rating.value, rating_max: product.metafields.reviews.rating.value.scale_max }}" style="--color-rating: {{ block.settings.color_rating }}">
                                                    <span aria-hidden="true" class="hdt-rating-star" style="--rating: {{ product.metafields.reviews.rating.value.rating | floor }}; --rating-max: {{ product.metafields.reviews.rating.value.scale_max }}; --rating-decimal: {{ rating_decimal }};"></span>
                                                    <span aria-hidden="true" class="hdt-rating-text hdt-s-text hdt-font-semibold">{{ product.metafields.reviews.rating.value }}</span>
                                                    {%- if product.metafields.reviews.rating_count > 0 -%}
                                                        <span class="hdt-rating-count hdt-s-text">({{ product.metafields.reviews.rating_count }}&nbsp;{{ 'accessibility.reviews' | t }})</span>
                                                    {%- endif -%}   
                                                </div>
                                                {%- endif -%}
                                              {%- endif -%}
                                            </div>
                                          {%- endif %}
                                          <a href="{{ block.settings.product.url }}" class="hdt-h5 hdt-hs-drawer-heading hdt-product-info__item--title hdt-product-info__item hdt-product-info__item--text-top hdt-product-info__item--text-bottom">{{ product.title }}</a>
                                          <div class="hdt-product-info__item hdt-product-info__item--price hdt-product-info__item--text-top hdt-product-info__item--text-bottom">{%- render 'card-price', product: product, price_class: 'hdt-text-2xl hdt-font-medium' -%}</div>
                                          {%- if product.description != blank -%}
                                            <div class="hdt-product-info__item hdt-product-info__item--desc hdt-product-info__item--text-top hdt-product-info__item--text-bottom">
                                              <div class="rte hdt-s-text">{{ product.description }}</div>
                                            </div>
                                          {%- endif -%}
                                        
                                      {%- else -%}
                                        <p class="hdt-h5 hdt-hs-drawer-heading hdt-product-info__item--title hdt-product-info__item hdt-product-info__item--text-top hdt-product-info__item--text-bottom">{{ 'onboarding.product_title' | t }}</p>
                                      {%- endif -%}
                                      {%- if block.settings.show_icon_with_text_1 or block.settings.show_icon_with_text_2 or block.settings.show_icon_with_text_3 or block.settings.show_icon_with_text_4 -%}
                                        {%- liquid
                                            if block.settings.layout == 'vertical'
                                                assign tag_block = 'div'
                                                assign tag_atrr = ''
                                                assign item_class = 'hdt-list-iconbox'
                                                assign wrap_class = 'hdt-product__iwt-vertical hdt-product-info__item--box-top hdt-product-info__item--box-bottom'
                                            else
                                                assign tag_block = 'hdt-marquee'
                                                assign tag_atrr = 'speed-factor="' | append: block.settings.speed | append: '" direction="' | append: block.settings.direction | append: '" pausable'
                                                assign item_class = 'hdt-marquee-item hdt-inline-flex hdt-align-center'
                                                assign wrap_class = 'hdt-marquee hdt-block hdt-relative hdt-oh hdt-scrollbar hdt-product-info__item--box-top hdt-product-info__item--box-bottom'
                                            endif
                                        -%}
                                        <{{ tag_block }} {{ tag_atrr }} class="hdt-product-info__item hdt-product-info__iwt {{ wrap_class }}">
                                            <div class="{{ item_class }}">
                                              {%- for i in (1..4) -%}
                                                  {%- liquid
                                                    assign show_item = 'show_icon_with_text_' | append: i
                                                    assign custom_icon = "custom_icon_" | append: i
                                                    assign icon = "icon_" | append: i
                                                    assign text = "text_" | append: i
                                                    if block.settings[custom_icon] != blank or block.settings[icon] != 'none'
                                                      assign has_item = true
                                                    else
                                                      assign has_item = false
                                                    endif
                                                  -%}
                                                  {%- if block.settings[show_item] and has_item -%}
                                                      <div class="hdt-product__icon-with-text" data-type="icon-with-text">
                                                          <div class="hdt-pi-icon-with-text hdt-s-text">
                                                              {%- if block.settings[custom_icon] != blank and block.settings[icon] == '--custom--' -%}
                                                                <span class="hdt-pi-icon">{{ block.settings[custom_icon] }}</span>
                                                              {%- elsif block.settings[icon] != '--custom--' -%}
                                                                <span class="hdt-pi-icon">{{ 'icon-' | append: block.settings[icon] | append: '.svg' | inline_asset_content }}</span>
                                                              {%- endif -%}
                                                              {%- if block.settings[text] != blank -%}
                                                                <div class="hdt-iwt-text rte hdt-font-medium">{{ block.settings[text] }}</div>
                                                              {%- endif -%}
                                                            </div>
                                                      </div>
                                                      {% if block.settings.layout == 'marquee' %}<div class="hdt-line-horizontal"></div>{% endif %}
                                                  {%- endif -%}
                                              {%- endfor -%}
                                          </div>
                                        </{{ tag_block }}>
                                      {%- endif -%}
                                      {%- if block.settings.link_text != '' -%}
                                        <div class="hdt-product-info__item--link_text hdt-product-info__item hdt-product-info__item--text-top hdt-product-info__item--box-bottom">
                                          <a href="{{ block.settings.product.url }}" class="hdt-s-text hdt-link-underline hdt-font-medium">{{ block.settings.link_text }}</a>
                                        </div>
                                      {%- endif -%}
                                    </div>
                                  {%- endif -%}
                                </div>
                              </div>
                            </div>
                          {%- endfor -%}
                        </div>
                      </div>
                    </hdt-slider>
                    {%- if section.blocks.size > 1 -%}
                    <hdt-slider-nav class="hdt-hotspots-with-drawer__nav-buttons hdt-slider-nav--outline" aria-controls="Slider-{{ section.id }}">
                      <div class="hdt-btn-heading-wrapper hdt-btn-heading-wrapper--prev">
                        <button aria-label="{{ 'accessibility.go_prev_slide' | t | escape }}" type="button" name="previous">{{- 'icon-nav-prev.svg' | inline_asset_content -}}</button>
                        <span></span>
                      </div>
                      <div class="hdt-btn-heading-wrapper hdt-btn-heading-wrapper--next">
                        <button aria-label="{{ 'accessibility.go_next_slide' | t | escape }}" type="button" name="next">{{- 'icon-nav-next.svg' | inline_asset_content -}}</button>
                        <span></span>
                      </div>
                    </hdt-slider-nav>
                    {%- endif -%}
                  </div>
                </div>
              </div>
            </div>
          </dialog>
        </hdt-drawer>
      </template></hdt-lazy-replace>
      </div>
      {%- if request.design_mode %}<div class="hdt-tooltip-des"></div>{% endif -%}
    </div>
  </div>
</hdt-hotspots-with-drawer>

{% schema %}
{
  "name": "t:names.hotspots_with_drawer",
  "tag": "section",
  "class": "hdt-section",
  "disabled_on": {
    "groups": ["*"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "reveal_on_scroll",
      "label": "t:settings.reveal_on_scroll",
      "info": "t:info.reveal_on_scroll",
      "default": true,
      "visible_if": "{{ settings.sections_reveal_on_scroll }}"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:settings.make_full_width",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "drawer_color_scheme",
      "label": "t:settings.drawer_color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "image_picker",
      "id": "image_mb",
      "label": "t:settings.image_mb",
      "info": "t:info.image_mb"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.overlay_opacity",
      "default": 20
    },
    {
      "type": "checkbox",
      "id": "header_inside",
      "label": "t:settings.header_inside",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "heading_bottom_fade",
      "label": "t:settings.heading_bottom_fade",
      "info": "t:info.heading_bottom_fade",
      "default": false,
      "visible_if": "{{ section.settings.header_inside }}"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme_inside",
      "label": "t:settings.color_scheme_inside",
      "default": "scheme-4"
    },
    {
      "type": "select",
      "id": "header_pos",
      "label": "t:settings.header_position",
      "options": [
        {
          "value": "top",
          "label": "t:options.top"
        },
        {
          "value": "bottom",
          "label": "t:options.bottom"
        }
      ],
      "default": "bottom",
      "visible_if": "{{ section.settings.header_inside }}"
    },
    {
      "type": "select",
      "id": "header_align",
      "label": "t:settings.header_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        }
      ],
      "default": "left",
      "visible_if": "{{ section.settings.header_inside == false }}"
    },
    {
      "type": "header",
      "content": "t:content.heading"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "t:settings.desktop_max_width",
      "min": 200,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 540
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "t:text_defaults.heading_text"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [

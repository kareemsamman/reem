{{ 'customer.css' | asset_url | stylesheet_tag }}
<div color-scheme="{{ section.settings.color_scheme }}" id="Section-{{ section.id }}" class="hdt-section__main-reset-password hdt-section-spacing hdt-s-gradient" style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px; --section-pt-xl: {{ section.settings.padding_top_xl }}px; --section-pb-xl: {{ section.settings.padding_bottom_xl }}px;">
  <div class="hdt-container">
    <div class="hdt-sign-wrap">
      <div id="reset-pw" class="hdt-sign-part">
        <div class="hdt-section__header hdt-text-center">
          <h1 class="hdt-heading hdt-h4">{{ 'customer.reset_password.title' | t }}</h1>
          <p class="hdt-caption hdt-text-md hdt-s-text2">{{ 'customer.reset_password.subtext' | t }}</p>
        </div>
        {%- form 'reset_customer_password', class: 'hdt-resetpw-form hdt-form--move-text hdt-text-center' -%}
          {%- if form.errors -%}
            <div class="hdt-form__alert hdt-form__alert--error hdt-rounded-sm">
              <p class="hdt-form-alert__title hdt-h6">{{ 'icon-error.svg' | inline_asset_content }} {{ 'customer.register.error_message' | t }}</p>
              <ul>
                {%- for field in form.errors -%}
                  <li>
                    {%- if field == 'form' -%}
                      {{- form.errors.messages[field] -}}
                    {%- else -%}
                      <a href="#input--{{ section.id }}--{{ field }}">{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</a>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
          <div class="hdt-form-row hdt-row-grid hdt-grid-cols-1">
            <div class="hdt-field hdt-field--with-icon__end{% if form.errors contains 'password' %} hdt-field--with-error{% endif %}">
              <input type="password" name="customer[password]" id="input--{{ section.id }}--password" class="hdt-input hdt-field__input" aria-required="true" autocomplete="new-password"{% if form.errors contains 'password' %} aria-invalid="true" aria-describedby="password-error"{% endif %} placeholder="{{ 'customer.reset_password.password' | t }}">
              <label for="input--{{ section.id }}--password" class="hdt-field__label"><span class="hdt-truncate">{{ 'customer.reset_password.password' | t | escape }}</span></label>
              <hdt-show-password input-id="input--{{ section.id }}--password" class="hdt-show-pw hdt-field-icon hdt-field-icon--end">{{ 'icon-eye-open.svg' | inline_asset_content }}{{ 'icon-eye-slash.svg' | inline_asset_content }}</hdt-show-password>
              {%- if form.errors contains 'password' -%}
                <small id="password-error" class="hdt-form-field__msg hdt-s-text">{{ 'icon-error.svg' | inline_asset_content }} <span>{{ form.errors.translated_fields.password | capitalize }}  {{ form.errors.messages.password }}</span></small>
              {%- endif -%}
            </div>
          </div>
          <div class="hdt-form-row hdt-row-grid hdt-grid-cols-1">
            <div class="hdt-field hdt-field--with-icon__end{% if form.errors contains 'password_confirmation' %} hdt-field--with-error{% endif %}">
              <input type="password" name="customer[password_confirmation]" id="input--{{ section.id }}--password_confirmation" class="hdt-input hdt-field__input" aria-required="true" autocomplete="new-password"{% if form.errors contains 'password_confirmation' %} aria-invalid="true" aria-describedby="password_confirmation-error"{% endif %} placeholder="{{ 'customer.reset_password.password_confirmation' | t }}">
              <label for="input--{{ section.id }}--password" class="hdt-field__label"><span class="hdt-truncate">{{ 'customer.reset_password.password' | t | escape }}</span></label>
              <hdt-show-password input-id="input--{{ section.id }}--password_confirmation" class="hdt-show-pw hdt-field-icon hdt-field-icon--end">{{ 'icon-eye-open.svg' | inline_asset_content }}{{ 'icon-eye-slash.svg' | inline_asset_content }}</hdt-show-password>
              {%- if form.errors contains 'password' -%}
                <small id="password_confirmation-error" class="hdt-form-field__msg hdt-s-text">{{ 'icon-error.svg' | inline_asset_content }} <span>{{ form.errors.translated_fields.password_confirmation | capitalize }}  {{ form.errors.messages.password_confirmation }}</span></small>
              {%- endif -%}
            </div>
          </div>
          <button circle-bg-wrap type="submit" class="hdt-btn hdt-btn-solid hdt-btn--size-s hdt-btn-full-width">
            {{- 'customer.reset_password.submit' | t -}}
            <hdt-circle-bg mousemove></hdt-circle-bg>
          </button>
        {%- endform -%}
      </div>
    </div>
  </div>
</div>


{% schema %}
{
  "name": "t:names.reset_password",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.section_padding"
    },
    {
      "type": "range",
      "id": "padding_top_xl",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:settings.padding_top",
      "default": 60
    },
    {
        "type": "range",
        "id": "padding_bottom_xl",
        "min": 0,
        "max": 200,
        "step": 4,
        "unit": "px",
        "label": "t:settings.padding_bottom",
        "default": 60
    },
    {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 200,
        "step": 4,
        "unit": "px",
        "label": "t:settings.padding_top_mb",
        "default": 40
    },
    {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 200,
        "step": 4,
        "unit": "px",
        "label": "t:settings.padding_bottom_mb",
        "default": 40
    }
  ]
}
{% endschema %}
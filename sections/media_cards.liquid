
{%- liquid
    assign col_tablet = section.settings.columns | at_most: 2  
    assign slide_active_xl = false
    if section.blocks.size > section.settings.columns
      assign slide_active_xl = true
    endif
    assign slide_active_md = false
    if section.blocks.size > col_tablet
      assign slide_active_md = true
    endif
-%}
{%- style -%}
  @media (min-width: 768px){
    #Section-{{ section.id }} .hdt-slider{
      --slide-spacing: {{ section.settings.spacing_xl }}px
    }
  }
{%- endstyle -%}
<div color-scheme="{{ section.settings.color_scheme }}" id="Section-{{ section.id }}" class="hdt-section_media-cards hdt-section-spacing hdt-s-gradient mb:hdt-slider__overflow" style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px; --section-pt-xl: {{ section.settings.padding_top_xl }}px; --section-pb-xl: {{ section.settings.padding_bottom_xl }}px;">
    <div class="hdt-container{% if section.settings.full_width %}-xl{% endif %}">
        {%- content_for 'block', type: '_section_header', id: 'section-header' -%}
        <hdt-slider-reveal {% if settings.sections_reveal_on_scroll %} reveal-on-scroll{% endif %} id="Slider-{{ section.id }}" autoheight data-blocks_size="{{ section.blocks.size }}" class="hdt-slider md:hdt-slider__active-{{ slide_active_md }} xl:hdt-slider__active-{{ slide_active_xl }} xl:hdt-slides-{{ section.settings.columns }} md:hdt-slides-{{ col_tablet }} hdt-slides-1" config='{"autoHeight": false, "active": true, "loop": false, "fade": false, "slidesToScroll": "auto", "breakpoints": { "(min-width: 768px)": { "active": {{ slide_active_md }} }, "(min-width: 1150px)": { "active": {{ slide_active_xl }} } } }' style="--slide-size-set-mb: {{ section.settings.slide_width }}%;">
            <div class="hdt-slider__viewport{% if section.settings.slide_width == 50 or section.settings.slide_width == 100 %} mb:hdt-slider__viewport--hidden{% endif %}">
                <div class="hdt-slider__container">
                    {%- content_for 'blocks' -%}
                </div>
                <hdt-slider-dots aria-controls="Slider-{{ section.id }}" class="hdt-slider-dots hdt-slider-dots__progressbar{% if section.settings.slide_width != 50 and section.settings.slide_width != 100 %} hdt-hidden@mobile{% endif %}" class="no-js-hidden" hidden></hdt-slider-dots>
            </div>
        </hdt-slider-reveal>
    </div>
</div>
{% schema %}
    {
        "name": "t:names.media_cards",
        "tag": "section",
        "class": "hdt-section",
        "disabled_on": {
            "groups": ["*"]
        },
        "max_blocks": 8,
        "blocks": [{"type": "_section_header"}, {"type": "_media_card"}],
        "settings": [
            {
                "type": "select",
                "id": "tilt_card_hover",
                "label": "t:settings.hover_effect",
                "options": [
                    {
                        "value": "blur",
                        "label": "t:options.blur"
                    },
                    {
                        "value": "tilt",
                        "label": "t:options.tilt"
                    }
                ],
                "default": "tilt"
            },
            {
                "type": "select",
                "id": "media_height",
                "label": "t:settings.media_height",
                "options":[
                    {
                        "value": "adapt_image_first",
                        "label": "t:options.adapt_to_first_image"
                    },
                    {
                        "value": "image",
                        "label": "t:options.adapt_to_image"
                    },
                    {
                        "value": "fixed",
                        "label": "t:options.fixed_height"
                    }
                ],
                "default": "fixed"
            },
            {
                "type": "range",
                "id": "media_height_fixed",
                "label": "t:settings.fixed_height",
                "min": 300,
                "max": 800,
                "step": 50,
                "unit": "px",
                "default": 500,
                "visible_if": "{{ section.settings.media_height == 'fixed' }}"
            },
            {
                "type": "select",
                "id": "media_height_mb",
                "label": "t:settings.media_height_mb",
                "options":[
                    {
                        "value": "adapt_image_first",
                        "label": "t:options.adapt_to_first_image"
                    },
                    {
                        "value": "image",
                        "label": "t:options.adapt_to_image"
                    },
                    {
                        "value": "fixed",
                        "label": "t:options.fixed_height"
                    }
                ],
                "default": "fixed"
            },
            {
                "type": "range",
                "id": "media_height_fixed_mb",
                "label": "t:settings.fixed_height_mb",
                "min": 300,
                "max": 800,
                "step": 50,
                "unit": "px",
                "default": 500,
                "visible_if": "{{ section.settings.media_height_mb == 'fixed' }}"
            },
            {
                "type": "range",
                "id": "columns",
                "min": 1,
                "max": 5,
                "default": 3,
                "step": 1,
                "label": "t:settings.number_card",
                "info": "t:info.automatic_small_screen"
            },
            {
                "type": "range",
                "id": "spacing_xl",
                "label": "t:settings.desktop_spacing",
                "min": 0,
                "max": 50,
                "step": 1,
                "unit": "px",
                "default": 24
            },
            {
                "type": "range",
                "id": "slide_width",
                "label": "t:settings.item_width_mb",
                "info": "t:info.slide_width_mb",
                "min": 50,
                "max": 100,
                "step": 1,
                "unit": "%",
                "default": 85
              },
            {
                "type": "header",
                "content": "t:content.appearance"
            },
            {
                "type": "checkbox",
                "id": "full_width",
                "label": "t:settings.make_full_width",
                "default": true
            },
            {
                "type": "color_scheme",
                "id": "color_scheme",
                "label": "t:settings.color_scheme",
                "default": "scheme-1"
            },
            {
                "type": "header",
                "content": "t:content.section_padding"
            },
            {
                "type": "range",
                "id": "padding_top_xl",
                "min": 0,
                "max": 200,
                "step": 4,
                "unit": "px",
                "label": "t:settings.padding_top",
                "default": 60
            },
            {
                "type": "range",
                "id": "padding_bottom_xl",
                "min": 0,
                "max": 200,
                "step": 4,
                "unit": "px",
                "label": "t:settings.padding_bottom",
                "default": 60
            },
            {
                "type": "range",
                "id": "padding_top",
                "min": 0,
                "max": 200,
                "step": 4,
                "unit": "px",
                "label": "t:settings.padding_top_mb",
                "default": 40
            },
            {
                "type": "range",
                "id": "padding_bottom",
                "min": 0,
                "max": 200,
                "step": 4,
                "unit": "px",
                "label": "t:settings.padding_bottom_mb",
                "default": 40
            }
        ],
        "presets": [
            {
                "name": "t:names.media_cards",
                "category": "t:categories.storytelling",
                "blocks": [
                    {
                        "type": "_media_card",
                        "blocks": [
                            {
                                "type": "heading",
                                "settings": {
                                    "heading_size": "h6"
                                }
                            },
                            {
                                "type": "text",
                                "settings": {
                                    "text_size": "lg"
                                },
                            },
                            {
                                "type": "_button",
                                "settings": {
                                    "button_size": "s"
                                }
                            }
                        ]
                    },
                    {
                        "type": "_media_card",
                        "blocks": [
                            {
                                "type": "heading",
                                "settings": {
                                    "heading_size": "h6"
                                }
                            },
                            {
                                "type": "text",
                                "settings": {
                                    "text_size": "lg"
                                },
                            },
                            {
                                "type": "_button",
                                "settings": {
                                    "button_size": "s"
                                }
                            }
                        ]
                    },
                    {
                        "type": "_media_card",
                        "blocks": [
                            {
                                "type": "heading",
                                "settings": {
                                    "heading_size": "h6"
                                }
                            },
                            {
                                "type": "text",
                                "settings": {
                                    "text_size": "lg"
                                },
                            },
                            {
                                "type": "_button",
                                "settings": {
                                    "button_size": "s"
                                }
                            }
                        ]
                    },
                ]
            }

        ]
    }
{% endschema %}
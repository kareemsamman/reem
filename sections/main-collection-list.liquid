{%- comment -%}
 theme.collections
{%- endcomment -%}

{%- liquid
    assign sub_collections = collection.metafields.ecomposer.collections.value
    if sub_collections == blank or sub_collections.size == 0
      assign sub_collections = section.settings.collection_list
    endif
-%}
<div style="background:#ffeb3b;padding:12px;font-family:monospace;font-size:14px;border:2px solid red;">
  DEBUG: collection = {{ collection.handle }}<br>
  metafield raw = {{ collection.metafields.ecomposer.collections.value | json }}<br>
  sub_collections.size = {{ sub_collections.size }}<br>
  sub_collections handles = {% for c in sub_collections %}{{ c.handle }}, {% endfor %}
</div>
{%- if sub_collections != blank and sub_collections.size > 0 -%}
{%- liquid
    if section.settings.reveal_on_scroll and settings.sections_reveal_on_scroll
      assign reveal = 'reveal'
    else
      assign reveal = ''
    endif
-%}
<hdt-collection-dynamic {% if reveal == 'reveal' %}reveal-on-scroll{% endif %} id="Section-{{ section.id }}" color-scheme="{{ section.settings.color_scheme }}" class="hdt-collection-list--dynamic hdt-s-gradient hdt-section-spacing" style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px; --section-pt-xl: {{ section.settings.padding_top_xl }}px; --section-pb-xl: {{ section.settings.padding_bottom_xl }}px">
    <div class="hdt-container-xl hdt-slider__overflow">
        <hdt-slider id="Slider-{{ section.id }}" autoheight class="hdt-slider hdt-slider__active-true hdt-relative" config='{ "active": true, "autoHeight": true, "ntCenter": false, "loop": false, "slidesToScroll": "auto", "dragFree": false, "breakpoints": { "(min-width: 768px)": {  "active": true } } }'>
            <div class="hdt-slider__viewport">
            <div role="list" class="hdt-slider__container">
                {%- for collection_item in sub_collections -%}
                    {%- assign image = collection_item.metafields.theme.image.value | default: collection_item.featured_image -%}
                    <div {{ reveal }} role="listitem" class="hdt-slider__slide hdt-collection-dynamic-item hdt-collection-list__item">
                        <a circle-bg-wrap href="{{ collection_item.url }}" aria-label="{{ 'accessibility.go_to_collection' | t: collection: collection_item.title | escape }}" class="hdt-collection-list__link  hdt-btn-effhover">
                            <div class="hdt-collection-list__image hdt-ratio hdt-ratio--square">
                            {%- liquid
                            if image != blank
                                echo image | image_url: width: image.width | image_tag: sizes: '50px', widths: '50,100'
                            else
                                 echo 'collection-apparel-1' | placeholder_svg_tag: 'hdt-placeholder-svg'
                            endif
                            -%}
                            </div>
                            <div class="hdt-collection-list__title hdt-text-xl hdt-font-medium" aria-hidden="true">{{ collection_item.title | escape }}<sup class="hdt-pr-number">{{ collection_item.all_products_count }}</sup></div>
                            <hdt-circle-bg mousemove></hdt-circle-bg>
                        </a>
                    </div>
                {%- endfor -%}
            </div>
            </div>
        </hdt-slider>
    </div>
</hdt-collection-dynamic>
{%- endif -%}
{% schema %}
{
    "name": "t:names.sub_collections",
    "tag": "section",
    "limit": 1,
    "enabled_on": {
        "templates": ["collection"],
    },
    "class": "hdt-section",
    "settings": [
        {
            "type": "checkbox",
            "id": "reveal_on_scroll",
            "label": "t:settings.reveal_on_scroll",
            "default": true,
            "visible_if": "{{ settings.sections_reveal_on_scroll }}"
        },
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:settings.color_scheme",
            "default": "scheme-1"
        },
        {
            "type": "collection_list",
            "id": "collection_list",
            "label": "t:settings.collection_list"
        },
        {
            "type": "header",
            "content": "t:content.section_padding"
        },
        {
            "type": "range",
            "id": "padding_top_xl",
            "min": 0,
            "max": 200,
            "step": 4,
            "unit": "px",
            "label": "t:settings.padding_top",
            "default": 40
        },
        {
            "type": "range",
            "id": "padding_bottom_xl",
            "min": 0,
            "max": 200,
            "step": 4,
            "unit": "px",
            "label": "t:settings.padding_bottom",
            "default": 40
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 200,
            "step": 4,
            "unit": "px",
            "label": "t:settings.padding_top_mb",
            "default": 20
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 200,
            "step": 4,
            "unit": "px",
            "label": "t:settings.padding_bottom_mb",
            "default": 20
        }
    ],
    "presets": [
        {
            "name": "t:names.sub_collections",
            "category": "t:categories.collections"
        }
    ],
}
{% endschema %}
<div color-scheme="{{ section.settings.color_scheme }}" class="hdt-s-gradient">
  <div class="hdt-container{% if section.settings.full_width %}-xl{% endif %} hdt-section-spacing" style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px; --section-pt-xl: {{ section.settings.padding_top_xl }}px; --section-pb-xl: {{ section.settings.padding_bottom_xl }}px">
    <hdt-product-observe form="form{{ section.id }}{{ product.id }}">
    <div id="main-product-{{ section.id }}" class="hdt-main-product">
      {%- content_for 'block', type: '_product-media', id: 'media' -%}
      {%- content_for 'block', type: '_product-info', id: 'info' -%}
    </div>
    </hdt-product-observe>
  </div>
</div>
<script type="application/ld+json">{{ product | structured_data }}</script>

{% schema %}
{
  "name": "t:names.main_product",
  "tag": "section",
  "class": "hdt-section hdt-section-main hdt-section-main--product",
  "settings": [
    {
        "type": "header",
        "content": "t:content.appearance"
    },
    {
        "type": "checkbox",
        "id": "full_width",
        "label": "t:settings.make_full_width",
        "default": false
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "t:settings.color_scheme",
        "default": "scheme-1"
      },
    {
        "type": "header",
        "content": "t:content.section_padding"
    },
    {
        "type": "range",
        "id": "padding_top_xl",
        "min": 0,
        "max": 200,
        "step": 4,
        "unit": "px",
        "label": "t:settings.padding_top",
        "default": 60
    },
    {
        "type": "range",
        "id": "padding_bottom_xl",
        "min": 0,
        "max": 200,
        "step": 4,
        "unit": "px",
        "label": "t:settings.padding_bottom",
        "default": 60
    },
    {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 200,
        "step": 4,
        "unit": "px",
        "label": "t:settings.padding_top_mb",
        "default": 40
    },
    {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 200,
        "step": 4,
        "unit": "px",
        "label": "t:settings.padding_bottom_mb",
        "default": 40
    }
  ]
}
{% endschema %}
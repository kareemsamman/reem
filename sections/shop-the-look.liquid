{%- capture media_overlay -%}
    {%- content_for 'block', type: '_media-overlay', id: 'static-media-overlay' -%}
{%- endcapture -%}

{%- if media_overlay != blank -%}
    {%- liquid
        if section.index == 1
            assign lazy_load = 'eager'
        else
            assign lazy_load = 'lazy'
        endif
        assign swatch_list = 'products.theme_settings.swatch' | t | downcase | strip | replace: ' ,', ',' | replace: ', ', ',' | split: ',' | uniq
        assign product_list = section.settings.product_list
    -%}

    {%- capture sizes -%}
        (min-width:1150px) calc(min(100vw, {{ settings.page_width }}px) * 0.45 - 144px), (min-width: 1024px) calc((100vw - 100px) * 0.45 - 74px), (min-width: 768px) calc((100vw - 60px) * 0.44), calc((100vw - 30px) * 0.75)
    {%- endcapture -%}
    <div color-scheme="{{ section.settings.color_scheme }}" id="Section-{{ section.id }}" class="hdt-section__shop-the-look hdt-s-gradient hdt-section-spacing" style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px; --section-pt-xl: {{ section.settings.padding_top_xl }}px; --section-pb-xl: {{ section.settings.padding_bottom_xl }}px;">
        <div class="hdt-container">
            <div class="hdt-shop-the-look-wrapper">
                {{- media_overlay -}}
                <hdt-slider id="Slider-{{ section.id }}" class="hdt-shop-the-look-products hdt-slide-spacing-x hdt-slider__overflow hdt-slider{% if product_list.count > 1 or product_list == blank %} hdt-slider__active-true{% endif %} lg:hdt-slider__active-false" config='{"autoHeight": false, "active": true, "loop": false, "fade": false, "slidesToScroll": 1, "breakpoints": { "(min-width: 1024px)": { "active": false } } }'>
                    <div class="hdt-slider__viewport">
                        <div class="hdt-slider__container">
                            {%- liquid
                            echo media_overlay
                            if product_list != blank
                                for product in product_list
                                    if lazy_load == 'eager' and forloop.index > 2
                                        assign lazy_load = 'lazy'
                                    endif
                                    content_for 'block', type: '_product-card', id: 'static-product-card', closest.product: product, swatch_list: swatch_list, section_id: section.id, image_ratio: section.settings.pr_image_ratio, sizes: sizes, show_vendor: section.settings.show_vendor, card_style: section.settings.card_style, class_card: 'hdt-slider__slide', lazy_load: lazy_load, info_center: section.settings.pr_text_alignment
                                endfor
                            else
                                for i in (1..3)
                                    capture current
                                    cycle 1, 2 , 3
                                    endcapture
                                    render 'product-card-placeholder', index_image: current, card_style: section.settings.card_style, image_ratio: section.settings.pr_image_ratio, class_card: 'hdt-slider__slide', info_center: section.settings.pr_text_alignment
                                endfor
                            endif
                            -%}
                        </div>
                    </div>
                </hdt-slider>
            </div>
        </div>
    </div>
{%- endif -%}

{% schema %}
    {
        "name": "t:names.shop_the_look",
        "class": "hdt-section",
        "tag": "section",
        "blocks": [{"type": "_media-overlay"}],
        "disabled_on": {
            "groups": ["*"]
        },
        "settings": [
            {
                "type": "product_list",
                "id": "product_list",
                "label": "t:settings.product_list",
                "limit": 5
            },
            {
                "type": "header",
                "content": "t:content.product_card"
            },
            {
                "type": "select",
                "id": "pr_image_ratio",
                "label": "t:settings.image_ratio",
                "options": [
                    {
                        "value": "adapt_image",
                        "label": "t:options.adapt_to_image"
                    },
                    {
                        "value": "portrait",
                        "label": "t:options.portrait"
                    },
                    {
                        "value": "square",
                        "label": "t:options.square"
                    }
                ],
                "default": "adapt_image"
            },
            {
                "type": "checkbox",
                "id": "show_vendor",
                "label": "t:settings.show_vendor",
                "default": true
            },
            {
                "type": "select",
                "id": "card_style",
                "label": "t:settings.style",
                "options": [
                    {
                        "value": "standard",
                        "label": "t:options.standard"
                    },
                    {
                        "value": "card",
                        "label": "t:options.card"
                    }
                ],
                "default": "standard"
            },
            {
                "type": "select",
                "id": "pr_text_alignment",
                "label": "t:settings.text_alignment",
                "options": [
                    {
                        "value": "left",
                        "label": "t:options.left"
                    },
                    {
                        "value": "center",
                        "label": "t:options.center"
                    }
                ],
                "default": "left",
            },
            {
                "type": "header",
                "content": "t:content.appearance"
            },
            {
                "type": "color_scheme",
                "id": "color_scheme",
                "label": "t:settings.color_scheme",
                "default": "scheme-1"
            },
            {
                "type": "header",
                "content": "t:content.section_padding"
            },
            {
                "type": "range",
                "id": "padding_top_xl",
                "min": 0,
                "max": 200,
                "step": 4,
                "unit": "px",
                "label": "t:settings.padding_top",
                "default": 100
            },
            {
                "type": "range",
                "id": "padding_bottom_xl",
                "min": 0,
                "max": 200,
                "step": 4,
                "unit": "px",
                "label": "t:settings.padding_bottom",
                "default": 100
            },
            {
                "type": "range",
                "id": "padding_top",
                "min": 0,
                "max": 200,
                "step": 4,
                "unit": "px",
                "label": "t:settings.padding_top_mb",
                "default": 60
            },
            {
                "type": "range",
                "id": "padding_bottom",
                "min": 0,
                "max": 200,
                "step": 4,
                "unit": "px",
                "label": "t:settings.padding_bottom_mb",
                "default": 60
            }
        ],
        "presets": [
            {
                "name": "t:names.shop_the_look",
                "category": "t:categories.products",
                "blocks": [
                    {
                        "type": "_media-overlay",
                        "id": "static-media-overlay",
                        "static": true,
                        "blocks": [
                            {
                                "type": "heading",
                                "settings": {
                                    "heading_size": "h3"
                                }
                            }, 
                            {
                                "type": "text",
                                "settings": {
                                    "text_size": "xl"
                                }
                            },
                            {
                                "type": "_button",
                                "settings": {
                                    "button_size": "s"
                                }
                            }
                        ]
                    }
                ]
            }
        ]
    }
{% endschema %}

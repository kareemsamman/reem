{%- liquid
  assign logo_justify = 'center'
  assign nav_justify = 'auto'
  assign icons_justify = 'end'
  assign header_layout = 'auto'
  case section.settings.logo_position
    when 'left-inline'
      assign header_layout = '"logo nav icons" / auto minmax(0, 1fr) auto'
      assign logo_justify = 'start'
    when 'left-center'
      assign header_layout = '"logo nav icons" / minmax(max-content, 1fr) auto minmax(max-content, 1fr)'
      assign logo_justify = 'start'
      assign nav_justify = 'center'
    when 'center-left'
      assign header_layout = '"nav logo icons" / minmax(max-content, 1fr) auto minmax(max-content, 1fr)'
      assign nav_justify = 'start'
    when 'center-right'
      assign header_layout = '"icons logo nav" / minmax(max-content, 1fr) auto minmax(max-content, 1fr)'
      assign nav_justify = 'end'
      assign icons_justify = 'start'
    else
  endcase
  if request.page_type == 'index' or request.page_type == 'collection' and section.settings.enable_collection_page
    assign enable_header_transparent = section.settings.enable_header_transparent
  else
    assign enable_header_transparent = false
  endif
  assign localization_id = 'Header'
  if localization.available_countries.size > 1
    assign show_country_selector = section.settings.enable_country_selector
    assign show_country_selector_mobile = section.settings.enable_country_selector_mobile
  else
    assign show_country_selector = false
  endif
  if  localization.available_languages.size > 1
    assign show_language_selector = section.settings.enable_language_selector
    assign show_language_selector_mobile = section.settings.enable_language_selector_mobile
  else
    assign show_language_selector = false
  endif
-%}

{% style %}
  .hdt-header-wrapper {
    --header-layout: {% if section.settings.mobile_logo_position == 'center' %}"nav logo icons" / minmax(0, 1fr) auto minmax(0, 1fr){% else %}"logo icons nav" / minmax(0, 1fr) auto auto{% endif %};
    --logo-width: {{ section.settings.logo_width }}px;
    --logo-width-mobile: {{ section.settings.logo_width_mb }}px;
    --logo-justify: {{ logo_justify }};
    --nav-justify: {{ nav_justify }};
    --icons-justify: {{ icons_justify }};
  }
  @media (min-width: 1024px) {
    .hdt-header-wrapper {
      --header-layout: {{ header_layout }};
    }
  }
  {%- if enable_header_transparent -%}
    {%- assign scheme = section.settings.color_scheme_transparent -%}
    {%- capture style_capture -%}
      --color-background: rgba({{ scheme.settings.background.rgba }});
      --color-text-rgb: {{ scheme.settings.text.rgb }};
      --gradient-background: transparent;
      box-shadow: none;
    {%- endcapture -%}
    :has(.section-sp-transparent:first-child):not(:has(.hdt-section-header~.shopify-section-group-header-group)) body {--hdt-logo-transparent: 1;}
    html:has(.section-sp-transparent:first-child):not(:has(.hdt-section-header--main.scrolled-past-header), :has(.hdt-header__nav .hdt-mega-menu[open], .hdt-header__nav .hdt-maybe-closing, .hdt-menu-mobile[open])) .hdt-sticky-header { {{ style_capture }} }
  {%- endif -%}
{% endstyle %}
{%- assign menu_mb = section.settings.menu_mb | default: section.settings.menu -%}

<hdt-sticky-header prefix="header" sticky-type="{{ section.settings.sticky_header_type }}" color-scheme="{{ section.settings.color_scheme }}" class="hdt-sticky-header hdt-header--{% if section.settings.header_boxed %}boxed{% else %}full hdt-s-gradient{% endif%}{% if section.settings.enable_glass_sticky %} hdt-sticky-header--glass{% endif %} hdt-block{% if enable_header_transparent %} hdt-overlay-header hdt-header-transparent-enable hdt-overlay-header-transparent{% endif %}{% if section.settings.header_boxed and section.settings.rounded_header %} hdt-rounded-header{% endif %}">
  {%- if menu_mb.links.size > 0 -%}
    <div class="hdt-nav-menu-bg-eff hdt-s-gradient hdt-container-xl"></div>
  {%- endif -%}
  <div class="hdt-header-container{% if section.settings.header_boxed %} hdt-s-gradient{% endif %} hdt-header__shadow hdt-container-xl{% if enable_header_transparent %} hdt-container--header-overlay{% endif %}">
    <div class="hdt-header-wrapper{% if section.settings.header_boxed %} hdt-container-xl{% endif %} hdt-logo-align--{{ section.settings.logo_position }}">
      {%- if request.page_type == 'index' and section.settings.enable_h1_tag -%}
      <h1 class="hdt-header__logo">
        <a href="{{ routes.root_url }}">
      {%- else -%}
      <a href="{{ routes.root_url }}" class="hdt-header__logo">
      {%- endif -%}
        {%- if section.settings.logo != blank -%}
          <div class="header__logo-img-wrapper hdt-grid">
            {%- capture sizes %}(min-width: 768px) {{ section.settings.logo_width }}px, {{ section.settings.logo_width_mb }}px{% endcapture -%}
            {%- capture widths %}{{ section.settings.logo_width }}, {{ section.settings.logo_width | times: 1.5 | round }}, {{ section.settings.logo_width | times: 2 }}{% endcapture -%}
            {%- liquid
            assign logo_alt = section.settings.logo.alt | default: shop.name | escape
            assign logo_height = section.settings.logo_width | divided_by: section.settings.logo.aspect_ratio | round
            if enable_header_transparent and section.settings.logo_transparent
              assign logo_alt = section.settings.logo_transparent.alt | default: logo_alt
              echo section.settings.logo_transparent | image_url: width: 600 | image_tag: class: 'header__logo-img header__logo-img--transparent hdt-grid-1x1 hdt-place-self-center', widths: widths, height: logo_height, width: section.settings.logo_width, alt: logo_alt, sizes: sizes, preload: true
            endif
            echo section.settings.logo | image_url: width: 600 | image_tag: class: 'header__logo-img hdt-grid-1x1 hdt-place-self-center', widths: widths, height: logo_height, width: section.settings.logo_width, alt: logo_alt, sizes: sizes, preload: true
            -%}
          </div>
        {%- else -%}
          <span class="hdt-header__heading hdt-h6">{{ shop.name }}</span>
        {%- endif -%}
      {%- if request.page_type == 'index' and section.settings.enable_h1_tag -%}
      </a></h1>
      {%- else -%}
      </a>
      {%- endif -%}

      {%- if menu_mb.links.size > 0 -%}
        <hdt-nav-hover-effect data-open-event="{{ section.settings.open_dropdown_on_event }}" class="hdt-nav-hover-effect hdt-header__nav hdt-s-text">{%- liquid
            render 'menu-drawer', menu_mb: menu_mb, localization_id: localization_id, show_country_selector_mobile: show_country_selector_mobile, show_language_selector_mobile: show_language_selector_mobile
            if section.settings.logo_position != 'center-drawer' and section.settings.menu.links.size > 0
              render 'header-mega-menu', section: section
            endif
          -%}
          <span class="hdt-mn-item-bg hdt-menu-eff-bg"></span>
        </hdt-nav-hover-effect>
      {%- endif -%}
      <div class="hdt-header__icons hdt-s-text">
        <div class="hdt-header__icons-wrapper hdt-flex hdt-align-center">
          {%- if show_country_selector or show_language_selector -%}
            <div class="hdt-localization-selector-wrap hdt-relative hdt-hidden">
              <button class="hdt-localization-selector hdt-inline-flex hdt-align-center" aria-haspopup="dialog" aria-expanded="false" aria-controls="Popover-{{ localization_id }}-Localization" aria-label="{% if show_country_selector and show_language_selector %}{{ 'accessibility.region_and_language' | t }}{% elsif show_country_selector %}{{ 'localization.country_aria_label' | t }}{% else %}{{ 'localization.language_aria_label' | t }}{% endif %}">
                {%- if show_country_selector -%}
                  {%- if section.settings.show_country_flag %}<img src="{{ localization.country | image_url: width: 44 }}" alt="{{ localization.country.name | escape }}" width="44" height="33" loading="lazy" class="hdt-disclosure__flag">{% endif -%}
                  <span>{% if section.settings.show_country_name %}{{ localization.country.name }} ({{ localization.country.currency.iso_code }} {{ localization.country.currency.symbol }}){% else %}{{ localization.country.currency.iso_code }} {{ localization.country.currency.symbol }}{% endif %}</span>
                {%- endif -%}
                {%- if show_language_selector -%}
                  {%- if show_country_selector -%}
                    <span>/</span><span>{{ localization.language.iso_code | upcase }}</span>
                  {%- else -%}
                    <span>{{ localization.language.endonym_name | capitalize }}</span>
                  {%- endif -%}
                {%- endif -%}
                {{- 'icon-carret-down.svg' | inline_asset_content -}}
              </button>
            </div>
          {%- endif -%}
          <a class="hdt-header__search-btn" href="{{ routes.search_url }}" aria-controls="Drawer-search" aria-label="{{ 'accessibility.search' | t | escape }}">
            {{- 'icon-header-search.svg' | inline_asset_content -}}
          </a>
          {%- if shop.customer_accounts_enabled -%}
          <a class="md:hdt-flex hdt-hidden" rel="nofollow" href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" aria-label="{% if customer %}{{ 'accessibility.account' | t | escape }}{% else %}{{ 'accessibility.login' | t | escape }}{% endif %}">
            {%- if settings.enable_customer_avatar and customer and customer.has_avatar? -%}
              {{ customer | avatar }}
            {%- elsif settings.enable_customer_avatar and customer and customer.first_name or customer.email -%}
              <svg class="hdt-icon-customer-avatar" aria-hidden="true" width="20" height="20" viewBox="0 0 20 20">
                <circle cx="10" cy="10" r="10" class="hdt-icon-background"/>
                <text x="50%" y="50%" dominant-baseline="central" text-anchor="middle" class="hdt-centered-char">{{- customer.email | default: customer.first_name | first | upcase -}}</text>
              </svg>
            {%- else -%}
              {{ 'icon-user.svg' | inline_asset_content }}
            {%- endif -%}
          </a>
          {%- endif -%}
          {%- assign cart_badge = section.settings.cart_icon_badge | append: section.settings.cart_icon_badge_mobile -%}
          <a href="{{ routes.cart_url }}" class="hdt-cart-icon hdt-cart-bubble hdt-relative" aria-controls="CartDrawer" aria-label="{{ 'accessibility.cart' | t | escape }}" cart-badge="{{ section.settings.cart_icon_badge }}" cart-badge-mobile="{{ section.settings.cart_icon_badge_mobile }}">
            <span class="sr-only">{{ 'accessibility.cart_count' | t: count: cart.item_count }}</span>
            {{- 'icon-cart-empty.svg' | inline_asset_content -}}
            {%- if cart_badge != 'nonenone' %}
              {%- if cart_badge contains 'dot' %}<hdt-cart-dot aria-hidden="true" class="hdt-absolute{% if cart.item_count > 0 %} is-visible{% endif %}"></hdt-cart-dot>{% endif -%}
              {%- if cart_badge contains 'count' %}<hdt-cart-count aria-hidden="true" class="hdt-absolute{% if cart.item_count > 0 %} is-visible{% endif %}">{{ cart.item_count }}</hdt-cart-count>{% endif -%}
            {% endif -%}
          </a>
        </div>
      </div>
      {%- if section.settings.logo_position == 'center-bellow' or section.settings.logo_position == 'center-remaining-bellow' -%}
      <button class="hdt-header__search-btn hdt-header__icons--search hdt-s-text lg:hdt-flex hdt-hidden" aria-controls="hdt-search-drawer" aria-label="Search">{{ 'icon-header-search.svg' | inline_asset_content }}</button>
      {%- endif -%}
      {%- if section.settings.logo_position contains 'bellow' %}<hr class="hdt-header__hr lg:hdt-flex hdt-hidden">{% endif -%}
    </div>
  </div>
</hdt-sticky-header>
{%- if show_country_selector or show_language_selector or show_country_selector_mobile or show_language_selector_mobile -%}
  <hdt-append-body hidden host><template>{%- render 'localization-form', id: localization_id, show_country_selector: show_country_selector, show_language_selector: show_language_selector, show_country_selector_mobile: show_country_selector_mobile, show_language_selector_mobile: show_language_selector_mobile -%}</template></hdt-append-body>
{%- endif -%}
<div class="hdt-nav-menu-open-backdrop" color-scheme="{{ section.settings.color_scheme }}"></div>

{% schema %}
{
  "name": "t:names.header",
  "tag": "header",
  "class": "hdt-section hdt-section-header-group hdt-section-header--main",
  "max_blocks": 10,
  "settings": [
    {
      "type": "checkbox",
      "id": "header_boxed",
      "label": "t:settings.header_boxed",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "rounded_header",
      "label": "t:settings.rounded_header",
      "default": true,
      "visible_if": "{{ section.settings.header_boxed }}"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "menu_color_scheme",
      "label": "t:settings.menu_color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "logo_position",
      "options": [
        {
          "value": "left-inline",
          "label": "t:options.header_left_inline"
        },
        {
          "value": "left-center",
          "label": "t:options.header_left_center"
        },
        {
          "value": "center-right",
          "label": "t:options.header_center_right"
        },
        {
          "value": "center-left",
          "label": "t:options.header_center_left"
        },
      ],
      "default": "left-inline",
      "label": "t:settings.desktop_layout"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:settings.logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 20,
      "max": 300,
      "step": 4,
      "default": 28,
      "unit": "px",
      "label": "t:settings.logo_width"
    },
    {
      "type": "range",
      "id": "logo_width_mb",
      "min": 20,
      "max": 200,
      "step": 2,
      "default": 28,
      "unit": "px",
      "label": "t:settings.logo_width_mb"
    },
    {
      "type": "select",
      "id": "sticky_header_type",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "on-scroll-up",
          "label": "t:options.on_scroll_up"
        },
        {
          "value": "always",
          "label": "t:options.always"
        }
      ],
      "default": "on-scroll-up",
      "label": "t:settings.sticky_header"
    },
    {
      "type": "checkbox",
      "id": "enable_glass_sticky",
      "visible_if": "{{ section.settings.sticky_header_type != 'none' }}",
      "default": true,
      "label": "t:settings.glass_sticky",
      "info": "t:info.sticky_header"
    },
    {
      "type": "checkbox",
      "id": "enable_h1_tag",
      "default": true,
      "label": "t:settings.enable_h1_tag.",
      "info": "t:info.enable_h1_tag"
    },
    {
      "type": "header",
      "content": "t:content.navigation"
    },
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "t:settings.menu"
    },
    {
      "type": "link_list",
      "id": "menu_mb",
      "label": "t:settings.menu_mb"
    },
    {
      "type": "select",
      "id": "text_font",
      "label": "t:settings.text_font",
      "default": "body",
      "options": [
        {
          "value": "heading",
          "label": "t:options.heading"
        },
        {
          "value": "body",
          "label": "t:options.body"
        }
      ]
    },
    {
      "type": "select",
      "id": "text_style",
      "label": "t:settings.text_style",
      "options": [
        {
          "value": "normal",
          "label": "t:options.normal"
        },
        {
          "value": "uppercase",
          "label": "t:options.uppercase"
        }
      ]
    },
    {
      "type": "select",
      "id": "open_dropdown_on_event",
      "label": "t:settings.open_dropdown_on_event",
      "info": "t:info.open_dropdown_on_event",
      "default": "hover",
      "options": [
        {
          "value": "click",
          "label": "t:options.click"
        },
        {
          "value": "hover",
          "label": "t:options.hover"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:content.localization",
      "info": "t:info.header_country_selector"
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "default": false,
      "label": "t:settings.country_region"
    },
    {
      "type": "checkbox",
      "id": "show_country_name",
      "default": true,
      "label": "t:settings.country_name",
      "visible_if": "{{ section.settings.enable_country_selector or section.settings.enable_country_selector_mobile }}"
    },
    {
      "type": "checkbox",
      "id": "show_country_flag",
      "default": true,
      "label": "t:settings.flag",
      "visible_if": "{{ section.settings.enable_country_selector or section.settings.enable_country_selector_mobile }}"
    },
    {
      "type": "checkbox",
      "id": "enable_language_selector",
      "default": false,
      "label": "t:settings.language_selector"
    },
    {
      "type": "header",
      "content": "t:content.mobile_layout"
    },
    {
      "type": "select",
      "id": "mobile_logo_position",
      "options": [
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "left",
          "label": "t:options.left"
        }
      ],
      "default": "center",
      "label": "t:settings.mobile_logo_position"
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector_mobile",
      "default": true,
      "label": "t:settings.country_region"
    },
    {
      "type": "checkbox",
      "id": "enable_language_selector_mobile",
      "default": true,
      "label": "t:settings.language_selector"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "default": true,
      "label": "t:settings.social_media_linkss",
      "info": "t:info.social_media_links"
    },
    {
      "type": "header",
      "content": "t:content.cart_icon_badge",
      "info": "t:info.cart_icon_badge",
    },
    {
      "type": "select",
      "id": "cart_icon_badge",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "dot",
          "label": "t:options.dot"
        },
        {
          "value": "count",
          "label": "t:options.count"
        }
      ],
      "default": "count",
      "label": "t:settings.badge"
    },
    {
      "type": "select",
      "id": "cart_icon_badge_mobile",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "dot",
          "label": "t:options.dot"
        },
        {
          "value": "count",
          "label": "t:options.count"
        }
      ],
      "default": "dot",
      "label": "t:settings.mobile_badge"
    },
    {
      "type": "header",
      "content": "t:content.transparent_header",
      "info": "t:info.transparent_header"
    },
    {
      "type": "checkbox",
      "id": "enable_header_transparent",
      "default": false,
      "label": "t:settings.header_transparent"
    },
    {
      "type": "checkbox",
      "id": "enable_collection_page",
      "default": true,
      "label": "t:settings.enable_on_collection_page",
      "visible_if": "{{ section.settings.enable_header_transparent }}"
    },
    {
      "type": "image_picker",
      "id": "logo_transparent",
      "label": "t:settings.logo_image",
      "info": "t:info.logo_transparent",
      "visible_if": "{{ section.settings.enable_header_transparent }}"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme_transparent",
      "visible_if": "{{ section.settings.enable_header_transparent }}",
      "label": "t:settings.color_scheme",
      "info": "t:info.color_scheme_transparent",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "mega_menu_featured",
      "name": "t:names.mega_menu_featured",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:settings.menu_item_label",
          "info": "t:info.menu_item_label"
        },
        {
          "type": "color_scheme",
          "id": "color_scheme",
          "label": "t:settings.color_scheme",
          "default": "scheme-1"
        },
        {
          "type": "checkbox",
          "id": "last_subitem_highlight",
          "label": "t:settings.last_subitem_highlight",
          "default": false
        },
        {
          "type": "header",
          "content": "t:content.collections"
        },
        {
          "type": "collection_list",
          "id": "collection_list",
          "limit": 4,
          "label": "t:settings.collection_list"
        },
        {
          "type": "checkbox",
          "id": "show_collections_mobile",
          "label": "t:settings.show_on_mobile",
          "default": true
        },
        {
          "type": "text",
          "id": "cl_btn_link_label",
          "label": "t:settings.button_label",
        },
        {
          "type": "url",
          "id": "cl_btn_link",
          "label": "t:settings.button_link",
        },
        {
          "type": "header",
          "content": "t:content.products"
        },
        {
          "type": "text",
          "id": "pl_heading",
          "label": "t:settings.heading"
        },
        {
          "type": "product_list",
          "id": "product_list",
          "limit": 6,
          "label": "t:settings.products"
        },
        {
          "type": "select",
          "id": "image_ratio",
          "options": [
            {
              "value": "adapt_image",
              "label": "t:options.adapt_to_image"
            },
            {
              "value": "portrait",
              "label": "t:options.portrait"
            },
            {
              "value": "square",
              "label": "t:options.square"
            },
            {
              "value": "landscape",
              "label": "t:options.landscape"
            },
            {
              "value": "4-3",
              "label": "t:options.4_3"
            }
          ],
          "default": "portrait",
          "label": "t:settings.image_ratio"
        },
        {
          "type": "checkbox",
          "id": "show_vendor",
          "label": "t:settings.show_vendor",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "show_products_mobile",
          "label": "t:settings.show_on_mobile",
          "default": true
        },
        {
          "type": "text",
          "id": "pl_btn_link_label",
          "label": "t:settings.button_label",
        },
        {
          "type": "url",
          "id": "pl_btn_link",
          "label": "t:settings.button_link",
        },
        {
          "type": "checkbox",
          "id": "show_icon_btn",
          "label": "t:settings.show_icon_btn",
          "default": true
        },
        {
          "type": "select",
          "label": "t:settings.icon_button",
          "id": "icon_btn_custom",
          "options": [
              {
                  "value": "angle-right",
                  "label": "t:options.ic_angle_right"
              },

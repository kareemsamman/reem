{%- style -%}
    {%- if section.settings.spacing == 0 -%}
    @media (max-width: 767px) { #Section-{{ section.id }} { --rounded-sm: 0px;{% if section.settings.full_width %}--padding: 1.5rem{% endif %} } }
    {%- endif -%}
    {%- if section.settings.spacing_md == 0 -%}
    @media (min-width: 768px) and (max-width: 1149px) { #Section-{{ section.id }} { --rounded-sm: 0px;{% if section.settings.full_width %}--padding: 3rem{% endif %} } }
    {%- endif -%}
    {%- if section.settings.spacing_xl == 0 -%}
    @media (min-width: 1150px) { #Section-{{ section.id }} { --rounded-sm: 0px;{% if section.settings.full_width %}--padding: 5rem{% endif %}} }
    {%- endif -%}
{%- endstyle -%}
<div color-scheme="{{ section.settings.color_scheme }}" id="Section-{{ section.id }}" class="hdt-section__collage hdt-section-spacing hdt-s-gradient" style="--spacing-xl: {{ section.settings.spacing_xl }}px;--spacing-md: {{ section.settings.spacing_md }}px;--spacing: {{ section.settings.spacing }}px;--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px; --section-pt-xl: {{ section.settings.padding_top_xl }}px; --section-pb-xl: {{ section.settings.padding_bottom_xl }}px;">
  <div class="hdt-container{% if section.settings.full_width %}-xl{% endif %}">
    {%- content_for 'block', type: '_section_header', id: 'header' -%}
    {%- content_for 'blocks' -%}
  </div>
</div>
{% schema %}
{
  "name": "t:names.collage",
  "tag": "section",
  "class": "hdt-section",
  "disabled_on": {
    "groups": ["*"]
  },
  "max_blocks": 2,
  "blocks": [{"type": "_section_header"}, {"type": "_collage_grid"}],
  "settings": [
    {
      "type": "select",
      "id": "select_grid",
      "label": "t:settings.collage_grid",
      "options": [
        {
          "value": "10",
          "label": "t:options.collage_grid_10"
        },
        {
          "value": "12",
          "label": "t:options.collage_grid_12"
        }
      ],
      "default": "12"
    },
    {
      "type": "header",
      "content": "t:content.spacing"
    },
    {
      "type": "range",
      "id": "spacing_xl",
      "label": "t:settings.desktop",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "spacing_md",
      "label": "t:settings.tablet",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "t:settings.mobile",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:settings.make_full_width",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.section_padding"
    },
    {
      "type": "range",
      "id": "padding_top_xl",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:settings.padding_top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_xl",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:settings.padding_bottom",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:settings.padding_top_mb",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:settings.padding_bottom_mb",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "t:names.collage",
      "category": "t:categories.storytelling",
      "settings": {
        "spacing_xl": 24,
        "spacing_md": 20
      },
      "blocks": [
        {
            "type": "_collage_grid",
            "blocks": [
                {
                    "type": "_collage_media",
                    "settings": {
                      "grid12_column_ident_xl": "3",
                      "grid12_column_ident_md": "6",
                      "grid_column_ident": "2",
                      "row_ident_xl": 1,
                      "row_ident_md": 1,
                      "row_ident": 1,
                    },
                    "blocks": [
                      {
                        "type": "heading",
                        "settings": {
                          "heading_size": "h6"
                        }
                      }
                    ]
                },
                {
                    "type": "_collage_media",
                    "settings": {
                      "grid12_column_ident_xl": "6",
                      "grid12_column_ident_md": "6",
                      "grid_column_ident": "2",
                      "row_ident_xl": 2,
                      "row_ident_md": 2,
                      "row_ident": 2,
                    },
                    "blocks": [
                      {
                        "type": "heading",
                        "settings": {
                          "heading_size": "h4"
                        }
                      }
                    ]
                },
                {
                    "type": "_collage_media",
                    "settings": {
                      "grid12_column_ident_xl": "3",
                      "grid12_column_ident_md": "6",
                      "grid_column_ident": "2",
                      "row_ident_xl": 1,
                      "row_ident_md": 1,
                      "row_ident": 1,
                    },
                    "blocks": [
                      {
                        "type": "heading",
                        "settings": {
                          "heading_size": "h6"
                        }
                      }
                    ]
                },
                {
                    "type": "_collage_media",
                    "settings": {
                      "grid12_column_ident_xl": "3",
                      "grid12_column_ident_md": "6",
                      "grid_column_ident": "2",
                      "row_ident_xl": 1,
                      "row_ident_md": 1,
                      "row_ident": 1,
                    },
                    "blocks": [
                      {
                        "type": "heading",
                        "settings": {
                          "heading_size": "h6"
                        }
                      }
                    ]
                },
                {
                    "type": "_collage_media",
                    "settings": {
                      "grid12_column_ident_xl": "3",
                      "grid12_column_ident_md": "6",
                      "grid_column_ident": "2",
                      "row_ident_xl": 1,
                      "row_ident_md": 1,
                      "row_ident": 1,
                    },
                    "blocks": [
                      {
                        "type": "heading",
                        "settings": {
                          "heading_size": "h6"
                        }
                      }
                    ]
                }
            ],
            "settings": {
              "row_height_xl": 330,
              "row_height_md": 150,
              "row_height": 150
            },
        }
      ]
    },
  ]
}
{% endschema %}
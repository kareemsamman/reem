{%- comment %} Check sizes image when Shopify update API {% endcomment -%}
<div can-reveal id="block-{{ block.id }}" class="hdt-theme-block hdt-flex-block hdt-icon-block hdt-s-text{{ block.settings.icon_color }}" style=" --height: {{ block.settings.height }}px; --height-md: {{ block.settings.height_md }}px; --height-xl: {{ block.settings.height_xl }}px;" {{ block.shopify_attributes }}>
    {%- if block.settings.image != blank -%}
      {%- capture sizes -%}
          (min-width: 1150px) {{ block.settings.height_xl | times: block.settings.image.aspect_ratio }}px, (min-width: 768px) {{ block.settings.height_md | times: block.settings.image.aspect_ratio }}px, {{ block.settings.height | times: block.settings.image.aspect_ratio }}px
      {%- endcapture -%}
    {%- endif -%}
    {%- liquid
      if block.settings.svg != blank
        echo block.settings.svg
      elsif block.settings.image != blank
        assign widths = '25, 50, 100, 200, 300, 400,' | append: block.settings.image.width
        echo block.settings.image | image_url: width: 400 | image_tag: widths: widths, sizes: sizes
      else
        echo 'icon-' | append: block.settings.icon | append: '.svg' | inline_asset_content
      endif
      -%}
  </div>
  

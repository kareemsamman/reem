{%- assign product = section.settings.product | default: product -%}
{%- if product.metafields.reviews.rating.value != blank -%}
{% liquid
    assign rating_decimal = 0
    assign decimal = product.metafields.reviews.rating.value.rating | modulo: 1
    if decimal >= 0.3 and decimal <= 0.7
    assign rating_decimal = 0.5
    elsif decimal > 0.7
    assign rating_decimal = 1
    endif
%}
<div class="hdt-rating" aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: product.metafields.reviews.rating.value, rating_max: product.metafields.reviews.rating.value.scale_max }}" style="--color-rating: {{ block.settings.color_rating }}">
    <span aria-hidden="true" class="hdt-rating-star" style="--rating: {{ product.metafields.reviews.rating.value.rating | floor }}; --rating-max: {{ product.metafields.reviews.rating.value.scale_max }}; --rating-decimal: {{ rating_decimal }};"></span>
    <span aria-hidden="true" class="hdt-rating-text hdt-s-text hdt-font-semibold">
        {{- product.metafields.reviews.rating.value -}}
    </span>
    {%- if product.metafields.reviews.rating_count > 0 -%}
        <span class="hdt-rating-count hdt-s-text">
            ({{- product.metafields.reviews.rating_count -}}&nbsp;{{- 'accessibility.reviews' | t -}})
        </span>
    {%- endif -%}   
</div>
{%- endif -%}
{% schema %}
    {
        "name": "t:names.rating",
        "tag": null,
        "settings": [
            {
                "type": "paragraph",
                "content": "t:content.rating_paragraph"
            },
            {
                "type": "color",
                "id": "color_rating",
                "label": "t:settings.rating_color",
                "default": "#FC9B2C"
            }
        ],
    }
{% endschema %}
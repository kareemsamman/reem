{%- liquid
  assign title = block.settings.heading | default: block.settings.page.title
  if block.settings.content != blank or block.settings.page.content != blank
    assign has_content = true
  else
    assign has_content = false
  endif
-%}
{%- if title != blank and has_content -%}
<div class="hdt-product-info__item hdt-product-info__accordion hdt-product-info__item--box{% if block.settings.standalone %} hdt-product-info__accordion--standalone{% endif %}" data-type="accordion">
    <hdt-accordion class="hdt-contents">
      <details id="Details--{{ block.id }}">
        <summary class="hdt-accordion-heading hdt-h6 hdt-font-semibold" aria-expanded="false" {{ block.shopify_attributes }}>
          <span class="hdt-icon-wrap">{{- 'icon-plus.svg' | inline_asset_content -}}</span>
          {{- title | escape -}}
        </summary>
        <div class="hdt-accordion-content rte hdt-s-text">
          {{- block.settings.content -}}
          {{- block.settings.page.content -}}
        </div>
      </details>
    </hdt-accordion>
</div>
{%- endif -%}

{% schema %}
{
  "name": "t:names._collapsible_row",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.collapsible_row_description"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "info": "t:info.collapsible_row_heading",
      "default": "t:text_defaults.collapsible_row"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "t:settings.row_content",
      "default": "t:text_defaults.text_content"
    },
    {
      "type": "page",
      "id": "page",
      "label": "t:settings.row_content_from_page"
    },
    {
      "type": "checkbox",
      "id": "standalone",
      "label": "t:settings.standalone",
      "default": false,
      "visible_if": "{{ block.settings.heading != blank and block.settings.content != blank or block.settings.heading != blank and block.settings.page != blank }}"
    },
  ],
  "presets": [
    {
      "name": "t:names._collapsible_row"
    }
  ]
}
{% endschema %}
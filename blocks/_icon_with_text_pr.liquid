
{%- capture list_iwts -%}
  {%- content_for 'blocks' -%}
{%- endcapture -%}
{%- if block.settings.layout == 'column' -%}
  <div class="hdt-product-info__iwt hdt-product__iwt-bento hdt-product-info__item hdt-product-info__item--box hdt-iwt-style-{{ block.settings.layout_style }}{% if block.settings.scrolling_mobile %} hdt-hidden@mobile{% endif %}">
    <hdt-bento {{ block.shopify_attributes }} config='{ "active": false, "checkRow": true, "breakpoints": { "(min-width: 1024px)": { "active": true, "cols": 2, "gapX": 20, "gapY": 16 }, "(min-width: 768px) and (max-width: 1023.98px), (min-width: 1920px)": { "active": true, "cols": 3, "gapX": 20, "gapY": 16 } } }'>
        {{- list_iwts | remove: '<div class="hdt-line-horizontal" unless-el></div>' -}}
    </hdt-bento>
  </div>
{%- endif -%}
{%- if block.settings.layout == 'marquee' or block.settings.layout == 'column' and block.settings.scrolling_mobile -%}
  <hdt-marquee class="hdt-product-info__item hdt-product-info__iwt hdt-marquee hdt-block hdt-relative hdt-oh hdt-scrollbar hdt-product-info__item--box hdt-iwt-style-{{ block.settings.layout_style }}{% if block.settings.layout == 'column' %} md:hdt-hidden{% endif %}" speed-factor="{{ block.settings.speed }}" direction="{{ block.settings.direction  }}" pausable {{ block.shopify_attributes }}>
    <div class="hdt-marquee-inner"><div class="hdt-marquee-item hdt-inline-flex hdt-align-center">
      {{- list_iwts -}}
    </div></div>
  </hdt-marquee>
{%- endif -%}

{% schema %}
{
  "name": "t:names.icon_with_texts",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "options": [
        {
          "value": "marquee",
          "label": "t:options.scolling"
        },
        {
          "value": "column",
          "label": "t:options.column"
        }
      ],
      "default": "marquee",
      "label": "t:settings.layout"
    },
    {
      "type": "checkbox",
      "id": "scrolling_mobile",
      "label":"t:settings.scrolling_mobile",
      "default": true,
      "visible_if": "{{ block.settings.layout  == 'column' }}"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "t:settings.style",
      "options": [
        {
          "value": "outline",
          "label": "t:options.outline"
        },
        {
          "value": "fill",
          "label": "t:options.fill"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "t:settings.speed",
      "min": 0.1,
      "max": 1,
      "step": 0.1,
      "unit": "sec",
      "default": 0.3,
      "visible_if": "{{ block.settings.layout == 'marquee' or block.settings.layout == 'column' and block.settings.scrolling_mobile }}"
    },
    {
      "type": "select",
      "id": "direction",
      "label": "t:settings.direction",
      "options": [
        {
          "value": "rtl",
          "label": "t:options.rtl"
        },
        {
          "value": "ltr",
          "label": "t:options.ltr"
        }
      ],
      "default": "rtl",
      "visible_if": "{{ block.settings.layout == 'marquee' or block.settings.layout == 'column' and block.settings.scrolling_mobile }}"
    },

  ],
  "blocks": [{"type": "_pr-item-icon-with-text"}],
  "presets": [
    {
      "name": "t:names.icon_with_texts",
      "blocks": [
        {
          "type": "_pr-item-icon-with-text",
          "settings": {
            "icon": "return",
            "text": "Fast and secure delivery"
          },
        },
        {
          "type": "_pr-item-icon-with-text",
          "settings": {
            "icon": "return-circle",
            "text": "30 days return"
          },
        },
        {
          "type": "_pr-item-icon-with-text",
          "settings": {
            "icon": "security-check",
            "text": "2-Year Warranty"
          },
        },
        {
          "type": "_pr-item-icon-with-text",
          "settings": {
            "icon": "atmos",
            "text": "Dolby Atmos"
          },
        },
        {
          "type": "_pr-item-icon-with-text",
          "settings": {
            "icon": "charge",
            "text": "Rapid charging"
          },
        },
        {
          "type": "_pr-item-icon-with-text",
          "settings": {
            "icon": "isolation",
            "text": "Passive noise isolation"
          },
        },
        {
          "type": "_pr-item-icon-with-text",
          "settings": {
            "icon": "cable",
            "text": "USB-C and 3.5 mm"
          },
        },
        {
          "type": "_pr-item-icon-with-text",
          "settings": {
            "icon": "mic",
            "text": "Dual microphone array"
          },
        },
        {
          "type": "_pr-item-icon-with-text",
          "settings": {
            "icon": "aware",
            "text": "Aware mode"
          },
        },
      ]
    }
  ]
}
{% endschema %}
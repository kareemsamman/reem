<div can-reveal class="hdt-theme-block hdt-theme-block--icon-with-text hdt-s-text{{ block.settings.color }} hdt-text-{{ block.settings.text_size }}{% if block.settings.hide_mobile %} hdt-hidden md:hdt-block{% endif %}" {{ block.shopify_attributes }}>
    <div class="hdt-iwt--wrap">
        {%- if block.settings.custom_icon != blank or block.settings.icon != 'none' -%}
            <div {{ block.shopify_attributes }} class="hdt-iwi--icon" style="--icon-h-md: {{ block.settings.icon_h_md }}px;--icon-h: {{ block.settings.icon_h }}px">
                {%- liquid
                if block.settings.custom_icon != blank
                    echo block.settings.custom_icon
                else
                    echo 'icon-' | append: block.settings.icon | append: '.svg' | inline_asset_content
                endif
                -%}
            </div>
        {%- endif -%}
        {%- if block.settings.text != blank -%}
            <div class="hdt-iwt--text rte">{{ block.settings.text }}</div>
        {%- endif -%}
    </div>
</div>


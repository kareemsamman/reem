{%- assign columns_minus_1 = section.settings.columns | minus: 1 -%}
{%- capture sizes -%}
  {%- if section.settings.full_width -%}
  (min-width: 1150px) calc((100vw - {{ section.settings.gap_img_xl | times: columns_minus_1 }}px) / {{ section.settings.columns }}), (min-width: 768px) calc((100vw - {{ section.settings.gap_img_xl | times: columns_minus_1 }}px) / {{ section.settings.columns | at_most: 3 }}), {{ section.settings.slide_width }}vw
  {%- else -%}
  (min-width: {{ settings.page_width }}px) {{ settings.page_width | divided_by: section.settings.columns }}px, (min-width: 1150px) calc((100vw - 100px) / {{ section.settings.columns }}), (min-width: 768px) calc((100vw - 60px) / {{ section.settings.columns | at_most: 3 }}), calc({{ section.settings.slide_width }}vw - 30px)
  {%- endif -%}
{%- endcapture -%}
{%- liquid
  assign block_index = section.blocks | find_index: 'id', block.id
  assign current = block_index | modulo: 3 | plus: 1
-%}
<div class="hdt-slider__slide" {{ block.shopify_attributes }}>
  {%- if block.settings.link != blank -%}
    <a href="{{ block.settings.link }}" calc-nav{% if block.settings.open_in_new_tab %} target="_blank"{% endif %} class="hdt-ratio hdt-oh hdt-rounded-custom hdt-hover-mask">
  {%- else -%}
    <div class="hdt-ratio hdt-rounded-f hdt-rounded-custom hdt-hover-mask" calc-nav>
  {%- endif -%}
  {%- liquid
    if block.settings.image != blank
      echo block.settings.image | image_url: width: block.settings.image.width | image_tag: sizes: sizes, widths: '100,200,300,400,500,600,700,800,900,1000,1100,1200', class: 'hdt-zoom-img', pswp-el: ''
    else
      echo 'hero-apparel-' | append: current | placeholder_svg_tag: 'placeholder-svg hdt-placeholder hdt-zoom-img'
    endif
  -%}
  {%- if block.settings.link != blank -%}
    </a>
  {%- else -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:names.image",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image",
      "info": "t:info.image_1000"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link",
      "info": "t:info.optional"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "t:settings.open_in_new_tab",
      "default": true
    },
  ],
  "presets": [
    {
      "name": "t:names.image"
    }
  ]
}
{% endschema %}

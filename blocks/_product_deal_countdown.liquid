{%- assign product = closest.product -%}
{%- if product.metafields.theme.timer.list? == false and product.metafields.theme.timer.type contains 'date' and product.metafields.theme.timer.value != blank and product != blank -%}
  {%- assign date = product.metafields.theme.timer.value -%}
{%- else -%}
  {%- capture date %}{{ block.settings.year }}/{{ block.settings.month }}/{{ block.settings.day }} {{ block.settings.hour }}:{{ block.settings.minute }}{% endcapture -%}
{%- endif -%}
{%- assign date_at_time = date | date: format: 'date_at_time' -%}

<div color-scheme="{{ block.settings.color_scheme }}" class="hdt-product-info__item hdt-product-info__item--box hdt-s-gradient hdt-product-info-discount hide-cd-elapsed" data-type="product-discount" {{ block.shopify_attributes }}>
    {%- if block.settings.heading != '' or block.settings.coupon_code != '' -%}
        <div class="hdt-pr-cd-text">
            {% if block.settings.heading != ''  %}
                <p class="hdt-font-medium hdt-text-2xl">{{- block.settings.heading -}}</p>
            {% endif %}
            {%- if block.settings.coupon_code != '' -%}
            <div class="hdt-code-coupon-wrap">
                <label for="input-{{ block.id }}" class="sr-only">{{ block.settings.coupon_code }}</label>
                <input id="input-{{ block.id }}" class="hdt-discount-button__input hdt-s-text hdt-font-semibold" type="text" value="{{ block.settings.coupon_code }}" onclick="this.select();" readonly>
                <wrapp-hdt-copy-btn class="hdt-contents" text-id="input-{{ block.id }}" data-success-message="{{ 'accessibility.copied' | t | escape }}">
                <button circle-bg-wrap class="hdt-discount-button__copy hdt-font-medium hdt-btn--with-icon hdt-btn{% if block.settings.reverse_button %} hdt-btn-reverse{% endif %}" aria-label="{{ 'accessibility.btn_copy' | t }}" style="{% if settings.btn_case %} --font-size-button: var(--text-xs){% endif %}">
                    <span class="hdt-icon-copy">{{- 'icon-copy.svg' | inline_asset_content -}}</span>
                    <span>{{- 'accessibility.btn_copy' | t -}}</span>
                    <hdt-circle-bg mousemove></hdt-circle-bg>
                </button>
                </wrapp-hdt-copy-btn>
            </div>
            {%- endif -%}
        </div>
    {%- endif -%}
    <hdt-countdown class="hdt-theme-block hdt-countdown--end-{{ block.settings.action_elapsed }} hdt-countdown hdt-coundtdown-product hdt-coundtdown-box" aria-label="{{ 'accessibility.countdown_expired' | t: date_at_time: date_at_time }}" config='{"datetime": "{{ date | date: '%Y-%m-%dT%T' }}", "actionElapsed": "{{ block.settings.action_elapsed }}", "hasZero": false }'>      
      <hdt-countdown-item is="days">
        <div class="hdt-countdown-timer-numbers hdt-h5"><hdt-countdown-number num="0" eff hide-countdown-num>0</hdt-countdown-number><hdt-countdown-number num="0" eff>0</hdt-countdown-number><hdt-countdown-number num="0" eff>0</hdt-countdown-number></div><span part="tmp_num">00</span>
        <hdt-countdown-text singular="{{ 'countdown_timmer.day' | t | escape }}" class="hdt-countdown__text hdt-grid hdt-text-sm">{{ 'countdown_timmer.day_plural' | t }}</hdt-countdown-text>
      </hdt-countdown-item>
      <hdt-countdown-item is="hours">
        <div class="hdt-countdown-timer-numbers hdt-h5"><hdt-countdown-number num="0" eff>0</hdt-countdown-number><hdt-countdown-number num="0" eff>0</hdt-countdown-number></div><span part="tmp_num">00</span>
        <hdt-countdown-text singular="{{ 'countdown_timmer.hr' | t | escape }}" class="hdt-countdown__text hdt-grid hdt-text-sm">{{ 'countdown_timmer.hr_plural' | t }}</hdt-countdown-text>
      </hdt-countdown-item>
      <hdt-countdown-item is="minutes" numbers="00">
        <div class="hdt-countdown-timer-numbers hdt-h5"><hdt-countdown-number num="0" limit="6" eff>0</hdt-countdown-number><hdt-countdown-number num="0" eff>0</hdt-countdown-number></div><span part="tmp_num">00</span>
        <hdt-countdown-text singular="{{ 'countdown_timmer.min_lg' | t | escape }}" class="hdt-countdown__text hdt-grid hdt-text-sm">{{ 'countdown_timmer.min_large' | t }}</hdt-countdown-text>
      </hdt-countdown-item>
      <hdt-countdown-item is="seconds" numbers="00">
        <div class="hdt-countdown-timer-numbers hdt-h5"><hdt-countdown-number num="0" limit="6" eff>0</hdt-countdown-number><hdt-countdown-number num="0" eff>0</hdt-countdown-number></div><span part="tmp_num">00</span>
        <hdt-countdown-text singular="{{ 'countdown_timmer.sec_lg' | t | escape }}" class="hdt-countdown__text hdt-grid hdt-text-sm">{{ 'countdown_timmer.sec_large' | t }}</hdt-countdown-text>
      </hdt-countdown-item>
    </hdt-countdown>
    {%- if block.settings.action_elapsed == 'hide_cd_show_mess' %}<div class="hdt-countdown-mess hdt-align-self-center rte hdt-s-text hdt-text-lg hdt-uppercase" hidden>{{ block.settings.message }}</div>{% endif -%}
</div>

{% schema %}
    {
        "name": "t:names.deal_countdown",
        "tag": null,
        "settings": [
            {
                "type": "color_scheme",
                "id": "color_scheme",
                "label": "t:settings.color_scheme",
                "default": "scheme-3"
            },
            {
                "type": "text",
                "id": "heading",
                "label": "t:settings.heading",
                "default": "t:text_defaults.miss_deal"
            },
            {
                "type": "text",
                "id": "coupon_code",
                "label": "t:settings.coupon_code"
            },
            {
                "type": "checkbox",
                "id": "reverse_button",
                "label": "t:settings.reverse_button_colors",
                "default": false
            },
            {
                "type": "header",
                "content": "t:content.countdown"
            },
            {
                "type": "paragraph",
                "content": "t:content.coundown_timer"
            },
            {
                "type": "paragraph",
                "content": "t:content.timezone_help"
            },
            {
                "type": "range",
                "id": "year",
                "min": 2026,
                "max": 2050,
                "step": 1,
                "label": "t:settings.year",
                "default": 2028
            },
            {
                "type": "range",
                "id": "month",
                "min": 1,
                "max": 12,
                "step": 1,
                "label": "t:settings.month",
                "default": 4
            },
            {
                "type": "range",
                "id": "day",
                "min": 1,
                "max": 31,
                "step": 1,
                "label": "t:settings.day",
                "default": 19
            },
            {
                "type": "range",
                "id": "hour",
                "min": 0,
                "max": 23,
                "step": 1,
                "label": "t:settings.hour",
                "default": 0
            },
            {
                "type": "range",
                "id": "minute",
                "min": 0,
                "max": 59,
                "step": 1,
                "label": "t:settings.minute",
                "default": 0
            },
            {
                "type": "radio",
                "id": "action_elapsed",
                "options": [
                  {
                    "value": "zero",
                    "label": "t:options.leave_timer_at_zero"
                  },
                  {
                    "value": "hide",
                    "label": "t:options.hide_block"
                  },
                  {
                    "value": "hide_cd_show_mess",
                    "label": "t:options.hide_cd_show_mess"
                  }
                ],
                "default": "zero",
                "label": "t:settings.action_elapsed"
            },
            {
                "type": "inline_richtext",
                "id": "message",
                "label": "t:settings.timer_end_message",
                "default": "t:text_defaults.timer_end_message"
            },
        ],
        "presets": [
            {
                "name": "t:names.deal_countdown",
                "settings": {
                    "coupon_code": "SALE30%"
                }
            }
        ]
    }
{% endschema %}
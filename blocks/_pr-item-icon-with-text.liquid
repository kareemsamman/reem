{%- if block.settings.icon != 'none' or block.settings.text != blank -%}
    <div class="hdt-product__icon-with-text hdt-bento-item" data-type="icon-with-text">
        <div class="hdt-pi-icon-with-text hdt-s-text{% if block.settings.icon == 'none' %} hdt-pi-no-icon{% endif %}">
            {%- if block.settings.icon != 'none' -%}
              <span class="hdt-pi-icon">
                {%- liquid
                    if block.settings.custom_img_icon != blank
                        echo block.settings.custom_img_icon | image_url: width: '20' | image_tag: widths: '20,40', sizes: '20px'
                    elsif block.settings.custom_icon != blank
                        echo block.settings.custom_icon
                    else
                        echo 'icon-' | append: block.settings.icon | append: '.svg' | inline_asset_content
                    endif
                -%}
                </span>
            {%- endif -%}
            {%- if block.settings.text != blank %}<span class="hdt-pi-text hdt-font-medium">{{ block.settings.text }}</span>{% endif -%}
        </div>
    </div>
    <div class="hdt-line-horizontal" unless-el></div>
{%- endif -%}

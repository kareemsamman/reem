{%- render 'header-mega-menu', block: block, type: 'card' -%}

{% schema %}
{
  "name": "t:names.mega_menu_card",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:settings.menu_item_label",
      "info": "t:info.menu_item_label"
    },
    {
      "type": "checkbox",
      "id": "hightlight_lastmenu",
      "label": "t:settings.hightlight_lastmenu",
      "default": true,
    },
    {
      "type": "select",
      "id": "position",
      "label": "t:settings.cards_position",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "t:options.left"
        },
        {
          "value": "right",
          "label": "t:options.right"
        }
      ]
    },
    {
      "type": "text",
      "id": "menu_card_btn_lable",
      "label": "t:settings.button_label"
    },
    {
      "type": "url",
      "id": "menu_card_btn_link",
      "label": "t:settings.button_link"
    },
    {
      "type": "checkbox",
      "id": "show_icon_button",
      "label": "t:settings.show_icon",
      "default": true
    },
    {
        "type": "select",
        "label": "t:settings.icon_button",
        "id": "icon_btn_custom",
        "options": [
            {
                "value": "angle-right",
                "label": "t:options.ic_angle_right"
            },
            {
                "value": "angles-right",
                "label": "t:options.ic_angles_right"
            },
            {
                "value": "arrow-45deg",
                "label": "t:options.ic_arrow_45deg"
            },
            {
                "value": "arrow-45deg-2",
                "label": "t:options.ic_arrow_45deg_2"
            },
            {
                "value": "arrow-right-2",
                "label": "t:options.ic_arrow_right"
            },
            {
                "value": "arrow-circle-45deg-fill",
                "label": "t:options.ic_circle_arrow_45deg"
            },
            {
                "value": "arrow-circle-45deg-outline",
                "label": "t:options.ic_circle_arrow_45deg_outline"
            },
            {
                "value": "arrow-circle-right-fill",
                "label": "t:options.ic_circle_arrow_right"
            },
            {
                "value": "arrow-circle-right-outline",
                "label": "t:options.ic_circle_arrow_right_outline"
            },
        ],
        "default": "arrow-circle-45deg-fill",
        "visible_if": "{{ block.settings.show_icon_button == true }}"
    },
    {
      "type": "header",
      "content": "t:content.card_1"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "t:settings.image"
    },
    {
      "type": "text",
      "id": "title_1",
      "label": "t:settings.title"
    },
    {
      "type": "text",
      "id": "btn_1",
      "label": "t:settings.button"
    },
    {
      "type": "url",
      "id": "link_1",
      "label": "t:settings.link"
    },
    {
      "type": "header",
      "content": "t:content.card_2"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "t:settings.image"
    },
    {
      "type": "text",
      "id": "title_2",
      "label": "t:settings.title"
    },
    {
      "type": "text",
      "id": "btn_2",
      "label": "t:settings.button"
    },
    {
      "type": "url",
      "id": "link_2",
      "label": "t:settings.link"
    },
    {
      "type": "header",
      "content": "t:content.card_3"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "t:settings.image"
    },
    {
      "type": "text",
      "id": "title_3",
      "label": "t:settings.title"
    },
    {
      "type": "text",
      "id": "btn_3",
      "label": "t:settings.button"
    },
    {
      "type": "url",
      "id": "link_3",
      "label": "t:settings.link"
    },
    {
      "type": "header",
      "content": "t:content.card_4"
    },
    {
      "type": "image_picker",
      "id": "image_4",
      "label": "t:settings.image"
    },
    {
      "type": "text",
      "id": "title_4",
      "label": "t:settings.title"
    },
    {
      "type": "text",
      "id": "btn_4",
      "label": "t:settings.button"
    },
    {
      "type": "url",
      "id": "link_4",
      "label": "t:settings.link"
    },
  ],
  "presets": [
    { "name": "t:names.mega_menu_card" }
  ]
}
{% endschema %}
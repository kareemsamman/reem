{%- capture sizes -%}
  {%- if section.settings.full_width -%}
  (min-width: 1150px) calc((100vw - 180px) / {{  12 | divided_by: block.settings.col_xl }}), (min-width: 768px) calc((100vw - 60px) / {{  12 | divided_by: block.settings.col_md }}), calc((100vw - 30px) / {{  12 | divided_by: block.settings.col }})
  {%- else -%}
  (min-width: 1150px) calc((min(100vw, {{ settings.page_width }}px) - 180px) / {{ 12 | divided_by: block.settings.col_xl }}), (min-width: 768px) calc((100vw - 60px) / {{  12 | divided_by: block.settings.col_md }}), calc((100vw - 30px) / {{  12 | divided_by: block.settings.col }})
  {%- endif -%}
{%- endcapture -%}

<div style="--pd-t-col-mb: {{ block.settings.padding_top }}px;--pd-b-col-mb: {{ block.settings.padding_bottom }}px;--pd-l-col-mb: {{ block.settings.padding_left }}px;--pd-r-col-mb: {{ block.settings.padding_right }}px;--pd-t-col-md: {{ block.settings.padding_top_md }}px;--pd-b-col-md: {{ block.settings.padding_bottom_md }}px;--pd-l-col-md: {{ block.settings.padding_left_md }}px;--pd-r-col-md: {{ block.settings.padding_right_md }}px;--pd-t-col-xl: {{ block.settings.padding_top_xl }}px;--pd-b-col-xl: {{ block.settings.padding_bottom_xl }}px;--pd-l-col-xl: {{ block.settings.padding_left_xl }}px;--pd-r-col-xl: {{ block.settings.padding_right_xl }}px;{% if block.settings.use_custom_w %}--max-col: {{ block.settings.max_width }}px;{%  endif %}--color-overlay-opacity: {{ block.settings.image_overlay_opacity }}%;{% if block.settings.corner_radius > 0 or block.settings.corner_radius_mobile > 0 %}--corner-radius: {{ block.settings.corner_radius }}px;--corner-radius-mb: {{ block.settings.corner_radius_mobile }}px;{% endif %}" id="column-{{ block.id }}"{% unless block.settings.inherit_color_scheme %} color-scheme="{{ block.settings.color_scheme }}"{% endunless %} class="hdt-column-block xl:hdt-col-span-{{ block.settings.col_xl }} md:hdt-col-span-{{ block.settings.col_md }} hdt-col-span-{{ block.settings.col }} hdt-cell{% unless block.settings.inherit_color_scheme %} hdt-s-gradient{% endunless %}{% if block.settings.corner_radius > 0 or block.settings.corner_radius_mobile > 0 %} hdt-rounded-custom hdt-rounded-f{% endif %}{% if block.settings.image != blank %} hdt-hover-mask hdt-media-overlap-content hdt-column-block-overlay{% endif %}{% if block.settings.link != blank %} hdt-relative{% endif %}" {{ block.shopify_attributes }}>
  {%- liquid
  assign class_object_mb = 'hdt-zoom-img'
  if block.settings.image != blank
    assign append_w = block.settings.image.width | default: 4000
    assign widths = '400,600,800,1000,1200,1400,1600,1800,2000,2200,2400,2600,2800,3000,3200,' | append: append_w
    echo '<picture class="hdt-contents">'
    if block.settings.image_mb != blank and block.settings.image_mb != block.settings.image
      assign append_w_mb = block.settings.image_mb.width | default: 1000
      assign widths_mb = '200,400,600,800,1000,' | append: append_w_mb
      assign srcset = block.settings.image_mb | image_url: width: block.settings.image_mb.width | image_tag: widths: widths_mb, alt: null | split: 'srcset="' | last
      unless srcset contains 'src='
        echo '<source media="(max-width: 767px)" srcset="' | append: srcset | replace_first: 'style=', 'data-none='
      endunless
    endif
    echo block.settings.image | image_url: width: block.settings.image.width | image_tag: loading: 'lazy', sizes: sizes, class: class_object_mb, widths: widths
    echo '</picture>'
  endif
  -%}
  {%- if block.settings.link != blank %}<a href="{{ block.settings.link }}" class="hdt-group-block__link"{% if block.settings.open_in_new_tab %} aria-describedby="a11y-new-window-message" target="_blank" rel="noopener noreferrer"{% endif %}{% if block.settings.link_description == blank %} tabindex="-1"{% endif %}>{% if block.settings.link_description != blank %}<span class="sr-only">{{ block.settings.link_description | escape }}</span>{% else %}<span class="sr-only">{{ 'accessibility.link' | t | escape }}</span>{% endif %}</a>{% endif -%}
  <div class="hdt-column-block-wrapp xl:hdt-place-self-{{ block.settings.content_align_xl }} md:hdt-place-self-{{ block.settings.content_align_md }} hdt-place-self-{{ block.settings.content_align }}{% if block.settings.link != blank %} hdt-group-block__content{% endif %}">
    {%- content_for 'blocks' -%}
  </div>
</div>


{%- liquid
if block.settings.image_w == 'custom'
  assign width_xl = block.settings.width_xl
  assign width_md = block.settings.width_md
  assign width = block.settings.width
else
  assign width_xl = 5000
  assign width_md = 1500
  assign width = 700
endif
-%}
{%- capture sizes -%}
  {%- if block.settings.image != blank -%}
    (min-width: 1150px) min({{ width_xl | at_most: block.settings.image.width }}px, 100vw), (min-width: 768px) min({{ width_md | at_most: block.settings.image.width }}px, 100vw), min({{ width | at_most: block.settings.image.width }}px, 100vw)
  {%- endif -%}
{%- endcapture -%}
{%- capture style_corner_radius -%}
  --corner-radius: {%- if block.settings.corner_radius_unit == 'px' -%}{{ block.settings.corner_radius }}px;{% else %}{{ block.settings.corner_radius_percent }}%;{% endif -%}
  {%- if block.settings.custom_corner_radius_mobile -%}
  --corner-radius-mb: {%- if block.settings.corner_radius_unit_mobile == 'px' -%}{{ block.settings.corner_radius_mobile }}px;{% else %}{{ block.settings.corner_radius_percent_mobile }}%;{% endif -%}
  {%- else -%}
  --corner-radius-mb: var(--corner-radius);
  {%- endif -%}
{%- endcapture -%}

  <hdt-image-block can-reveal class="hdt-theme-block hdt-flex-block hdt-image-block hdt-block"{% if block.settings.image_w == 'custom' %} custom-w{% endif %} style="--aspect-ratio: {{ block.settings.image.aspect_ratio | default: 1 }}; --img-w: {{ block.settings.width }}px; --img-w-md: {{ block.settings.width_md }}px; --img-w-lg: {{ block.settings.width_xl }}px;{{ style_corner_radius }}" {{ block.shopify_attributes }}>
    {%- if block.settings.image_url != blank -%}
      <a href="{{ block.settings.image_url }}" aria-describedby="a11y-new-window-message" target="_blank" rel="noopener noreferrer">
    {%- endif -%}
    {%- liquid
    if block.settings.image != blank
      assign widths = '1, 100,200,300,400,600,800,1000,1200,1400,1600,1800,2000,2200,2400,2600,2800,3000,3200,' | append: block.settings.image.width
      echo block.settings.image | image_url: width: block.settings.image.width | image_tag: widths: widths, sizes: sizes, class: 'hdt-rounded-custom'
    else
      echo 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg hdt-placeholder hdt-rounded-custom'
    endif
    -%}
    {%- if block.settings.image_url != blank -%}
    </a>
    {%- endif -%}
  </hdt-image-block>

  {% schema %}
  {
    "name": "t:names.image",
    "tag": null,
    "settings": [
      {
        "type": "image_picker",
        "id": "image",
        "label": "t:settings.image"
      },
      {
        "type": "url",
        "id": "image_url",
        "label": "t:settings.link"
      },
      {
        "type": "select",
        "id": "image_w",
        "options": [
          {
            "value": "auto",
            "label": "t:options.auto"
          },
          {
            "value": "custom",
            "label": "t:options.custom"
          }
        ],
        "default": "auto",
        "label": "t:settings.width"
      },
      {
        "type": "header",
        "content": "t:content.maximum_width",
        "visible_if": "{{ block.settings.image_w == 'custom' }}"
      },
      {
        "type": "range",
        "id": "width_xl",
        "min": 100,
        "max": 1000,
        "step": 10,
        "unit": "px",
        "label": "t:settings.desktop",
        "default": 500,
        "visible_if": "{{ block.settings.image_w == 'custom' }}"
      },
      {
        "type": "range",
        "id": "width_md",
        "min": 100,
        "max": 1000,
        "step": 10,
        "unit": "px",
        "label": "t:settings.tablet",
        "default": 500,
        "visible_if": "{{ block.settings.image_w == 'custom' }}"
      },
      {
        "type": "range",
        "id": "width",
        "min": 100,
        "max": 1000,
        "step": 10,
        "unit": "px",
        "label": "t:settings.mobile",
        "default": 360,
        "visible_if": "{{ block.settings.image_w == 'custom' }}"
      },
    {
      "type": "header",
      "content": "t:content.corner_radius"
    },
    {
      "type": "select",
      "id": "corner_radius_unit",
      "options": [
        {
          "value": "px",
          "label": "t:options.pixel"
        },
        {
          "value": "%",
          "label": "t:options.percent"
        }
      ],
      "default": "px",
      "label": "t:settings.unit"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:settings.corner_radius",
      "visible_if": "{{ block.settings.corner_radius_unit == 'px' }}",
      "default": 0
    },
    {
      "type": "range",
      "id": "corner_radius_percent",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "%",
      "label": "t:settings.corner_radius",
      "visible_if": "{{ block.settings.corner_radius_unit == '%' }}",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "custom_corner_radius_mobile",
      "label": "t:settings.custom_corner_radius_mobile",
      "default": false
    },
    {
      "type": "header",
      "content": "t:content.corner_radius_mobile",
      "visible_if": "{{ block.settings.custom_corner_radius_mobile }}"
    },
    {
      "type": "select",
      "id": "corner_radius_unit_mobile",
      "visible_if": "{{ block.settings.custom_corner_radius_mobile }}",
      "options": [
        {
          "value": "px",
          "label": "t:options.pixel"
        },
        {
          "value": "%",
          "label": "t:options.percent"
        }
      ],
      "default": "px",
      "label": "t:settings.unit"
    },
    {
      "type": "range",
      "id": "corner_radius_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:settings.corner_radius",
      "visible_if": "{{ block.settings.corner_radius_unit_mobile == 'px' and block.settings.custom_corner_radius_mobile }}",
      "default": 0
    },
    {
      "type": "range",
      "id": "corner_radius_percent_mobile",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "%",
      "label": "t:settings.corner_radius",
      "visible_if": "{{ block.settings.corner_radius_unit_mobile == '%' and block.settings.custom_corner_radius_mobile }}",
      "default": 0
    }
    ],
    "presets": [
      {
        "name": "t:names.image"
      }
    ]
  }
  {% endschema %}
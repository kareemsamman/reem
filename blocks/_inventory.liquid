    </svg>
  {%- else -%}
    <svg class="hdt-icon-progress" width="15" height="15" aria-hidden="true"><circle cx="7.5" cy="7.5" r="7.5" fill="currentColor"></circle><circle cx="7.5" cy="7.5" r="5" stroke="rgb(255, 255, 255)" stroke-width="1" fill="currentColor"/></svg>
  {%- endif -%}
{%- endcapture -%}
{%- liquid
  assign tag_legend = 'span'
  assign show_progress = false
  if block.settings.show_progress_bar and product.available and pre_order_stock == false and out_of_stock == false
    assign tag_legend = 'legend'
    assign show_progress = true
  endif
-%}
  <div class="hdt-product-info__item hdt-product__inventory" data-type="inventory"{% if product.available %} data-need-update{% endif %} {{ block.shopify_attributes }}>
    <fieldset role="status" class="hdt-variant-inventory{% if show_progress == false %} hdt-progress-bar--empty{% endif %}">
      {%- if low_stock -%}
      <{{tag_legend }} class="hdt-inline-flex hdt-align-center hdt-stock-status hdt-font-medium hdt-stock-error"><span>{% if show_progress == false %}{{ stock_icon }}{%endif %}{{- 'products.product.inventory.low_stock' | t -}}</span></{{ tag_legend }}>
      {%- elsif low_stock_count -%}
      <{{tag_legend }} class="hdt-inline-flex hdt-align-center hdt-stock-status hdt-font-medium"><span class="hdt-stock-error">{% if show_progress == false %}{{ stock_icon }}{%endif %}{{- 'products.product.inventory.low_stock_show_count_html' | t: quantity: inventory_quantity -}}</span></{{ tag_legend }}>
      {%- elsif in_stock -%}
      <{{tag_legend }} class="hdt-inline-flex hdt-align-center hdt-stock-status hdt-font-medium hdt-stock-success"><span>{% if show_progress == false %}{{ stock_icon }}{%endif %}{{- 'products.product.inventory.in_stock' | t -}}</span></{{ tag_legend }}>
      {%- elsif in_stock_count -%}
      <{{tag_legend }} class="hdt-inline-flex hdt-align-center hdt-stock-status hdt-font-medium hdt-stock-success"><span>{% if show_progress == false %}{{ stock_icon }}{%endif %}{{- 'products.product.inventory.in_stock_show_count_html' | t: quantity: inventory_quantity -}}</span></{{ tag_legend }}>
      {%- elsif pre_order_stock -%}
      <{{tag_legend }} class="hdt-inline-flex hdt-align-center hdt-stock-status hdt-font-medium hdt-stock-warning"><span>{% if show_progress == false %}{{ stock_icon }}{%endif %}{{- 'products.product.inventory.out_of_stock_continue_selling' | t -}}</span></{{ tag_legend }}>
      {%- elsif out_of_stock -%}
      <{{tag_legend }} class="hdt-inline-flex hdt-align-center hdt-stock-status hdt-font-medium hdt-stock-error"><span>{% if show_progress == false %}{{ stock_icon }}{%endif %}{{- 'products.product.inventory.out_of_stock' | t -}}</span></{{ tag_legend }}>
      {%- endif -%}
      {%- if block.settings.show_progress_bar and product.available and pre_order_stock == false and out_of_stock == false %}
        <div class="hdt-progress-wrap">
            {{- stock_icon -}}
            <hdt-x-progress class="hdt-x-progress" aria-label="{{ 'products.product.inventory.product_inventory' | t }}" role="progressbar" reveal-in-view value="{% if inventory_quantity > 0 %}{{ inventory_quantity }}{% elsif selected_variant.available %}{{ block.settings.progress_bar_max }}{% endif %}" max="{{ block.settings.progress_bar_max }}" gradient="false" -colors='[ {"threshold":0,"color":"{{ settings.color_error }}"}, {"threshold":70,"color":"{{ settings.color_warning }}"}, {"threshold":100,"color":"{{ settings.color_success }}"} ]'></hdt-x-progress>
        </div>
      {% endif -%}
    </fieldset>
  </div>
  {% schema %}
  {
    "name": "t:names.inventory_status",
    "tag": null,
    "settings": [
      {
        "type": "range",
        "id": "inventory_threshold",
        "label": "t:settings.inventory_threshold",
        "info": "t:info.inventory_threshold",
        "min": 0,
        "max": 100,
        "step": 1,
        "default": 10
      },
      {
        "type": "checkbox",
        "id": "show_inventory_quantity",
        "label": "t:settings.show_inventory_quantity",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_progress_bar",
        "label": "t:settings.show_progress_bar",
        "default": true
      },
      {
        "type": "number",
        "id": "progress_bar_max",
        "visible_if": "{{ block.settings.show_progress_bar }}",
        "label": "t:settings.progress_bar_max",
        "default": 20
      }
    ],
    "presets": [
      {
        "name": "t:names.inventory_status",
      }
    ]
  }
{% endschema %}
{%- if block.settings.custom_img_icon != blank or block.settings.custom_icon != blank or block.settings.icon != 'none' -%}
<div {{ block.shopify_attributes }} class="hdt-icon-wrapper hdt-icon__type-{{ block.settings.icon_type }} hdt-s-text hdt-inline-flex" style="{% if block.settings.custom_img_icon != blank %}{% assign icon_w_md = block.settings.icon_h_md | times: block.settings.custom_img_icon.aspect_ratio %}{% assign icon_w = block.settings.icon_h | times: block.settings.custom_img_icon.aspect_ratio %}--icon-mw-md: {{ icon_w_md }}px;--icon-mw: {{ icon_w}}px;{% endif %}--icon-h-md: {{ block.settings.icon_h_md }}px;--icon-h: {{ block.settings.icon_h }}px">
    {%- liquid
    if block.settings.custom_img_icon != blank
    assign icon_w_md = icon_w_md | ceil
    assign icon_w = icon_w | ceil
    assign icon_w_md_2x = icon_w_md | times: 2
    assign icon_w_2x = icon_w | times: 2
    assign widths = icon_w_md_2x | append: ', ' | append: icon_w  | append: ', ' | append: icon_w_2x | append: ', ' | append: icon_w
    assign sizes = '(min-width: 768px) 22px, 11px' | replace_first: '22', icon_w_md   | replace_first: '11', icon_w
    assign max_w = icon_w_2x | at_least: icon_w_md_2x
    if block.settings.rounded_image
        assign img_class = 'hdt-custom-img-icon hdt-rounded-full'
    else
        assign img_class = 'hdt-custom-img-icon'
    endif
    echo block.settings.custom_img_icon | image_url: width: max_w | image_tag: widths: widths, sizes: sizes, class: img_class
    elsif block.settings.custom_icon != blank
    echo block.settings.custom_icon
    else
    echo 'icon-' | append: block.settings.icon | append: '.svg' | inline_asset_content
    endif
    -%}
</div>
{%- assign shape = section.settings.shape | default: 'none' -%}
{%- if shape != 'none' -%}
    <div class="hdt-shape-block hdt-shape__{{ shape }}"></div>
{%- endif -%}
{%- endif -%}


{%- liquid
  assign product = closest.product
  if settings.pick_mode == 'no' and product.variants_count > 1
    assign selected_variant = product.selected_variant
    unless selected_variant
      assign selected_variant = product
    endunless
  elsif settings.pick_mode == 'first' and settings.hide_sold_out == false
    assign selected_variant = product.selected_variant | default: product.variants.first
  else
    assign selected_variant = product.selected_or_first_available_variant
  endif
  if settings.use_onsale_badge and selected_variant.compare_at_price > selected_variant.price
    assign on_sale = true
    assign label_onsale_style = settings.label_onsale_style
  else
    assign on_sale = false
  endif
  assign new_badge = false
  if settings.use_new_badge
    assign now_timestamp = 'now' | date: '%s'
    assign date_start = product.created_at | date: '%s'
    assign diff = now_timestamp | minus: date_start
    assign diff_seconds = diff | divided_by: 3600 | floor
    assign diff_days = diff_seconds | divided_by: 24 | floor
    if diff_days < settings.new_day_added
      assign new_badge = true
    endif
  endif
  if selected_variant.inventory_management == 'shopify' and selected_variant.inventory_quantity <= 0 and selected_variant.available
    assign is_pre_order = true
  else
    assign is_pre_order = false
  endif
  if block.settings.uppercase_text
    assign badge_class = 'hdt-text-sm hdt-uppercase'
  else
    assign badge_class = 'hdt-text-base'
  endif
-%}

{%- capture badges_html -%}
  {%- if product.metafields.theme.bestseller_badge.value %}<span class="hdt-badge hdt-badge__bestseller {{ badge_class }}">{{ 'products.product.badges.bestseller' | t }}</span>{% endif -%}
  {%- if on_sale -%}
    {%- liquid
    if label_onsale_style == 'text'
      assign badge_class_sale = badge_class
    else
      assign badge_class_sale = 'hdt-text-sm'
    endif
    -%}
    <span is="on_sale" class="hdt-badge hdt-badge__on-sale {{ badge_class_sale }}"{% if product.price_varies or product.compare_at_price_varies %} data-need-update{% endif %}>
    {%- liquid
      if label_onsale_style == 'text'
        assign sale_t_final =  'products.product.badges.sale' | t
      elsif label_onsale_style == 'amount'
        assign save = selected_variant.compare_at_price | minus: selected_variant.price  | money_without_trailing_zeros
        assign sale_t_final = 'products.product.badges.save_amount' | t: amount: '[1904]' | replace_first: '[1904]', '<span percent>[1904]</span>'  | replace_first: '[1904]', save
      else
        assign save = selected_variant.compare_at_price | minus: selected_variant.price | times: 100.0 | divided_by: selected_variant.compare_at_price | round | at_least: 1
        assign sale_t_final = 'products.product.badges.save_percent' | t: percent: '[1904]' | replace_first: '[1904]', '<span percent>[1904]</span>'  | replace_first: '[1904]', save
      endif
      echo sale_t_final
      -%}
    </span>
  {%- endif -%}
  {%- if settings.use_preorder_badge and is_pre_order %}<span class="hdt-badge hdt-badge__pre_order {{ badge_class }}">{{ 'products.product.badges.pre_order' | t }}</span>{% endif -%}
  {%- if settings.use_soldout_badge and selected_variant.available == false %}<span class="hdt-badge hdt-badge__sold_out {{ badge_class }}"{% if product.available %} data-need-update{% endif %}>{{ 'products.product.badges.sold_out' | t }}</span>{% endif -%}
  {%- if new_badge %}<span class="hdt-badge hdt-badge__new {{ badge_class }}">{{ 'products.product.badges.new' | t }}</span>{% endif -%}
  {%- if product.metafields.theme.custom_badges.value != blank and settings.use_custom_badge -%}
    {%- for badge in product.metafields.theme.custom_badges.value limit: 5 -%}
      <span class="hdt-badge hdt-badge__custom hdt-badge__{{ badge | handle }} {{ badge_class }}">{{ badge | escape }}</span>
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}
{%- if badges_html != blank or settings.use_onsale_badge or settings.use_soldout_badge %}<div class="hdt-product-info__item hdt-product__badges hdt-product-info__item--box"{% if badges_html == blank %} hidden{% endif %} data-type="badges" {{ block.shopify_attributes }}>{{- badges_html -}}</div>{% endif -%}

{% schema %}
{
  "name": "t:names.badges",
  "tag": null,
  "settings": [
    {
      "type": "checkbox",
      "id": "uppercase_text",
      "label": "t:settings.uppercase",
      "default": true
    },
  ],
  "presets": [
    {
      "name": "t:names.badges"
    }
  ]
}
{% endschema %}
{%- liquid
    if section.index == 1
      assign loading = 'eager'
    else
      assign loading = 'lazy'
    endif
    assign class_object_mb = ''
    if block.settings.image_mb.presentation.focal_point != blank
      assign class_object_mb = 'hdt-object-pos-mb'
    endif

    assign block_index = section.blocks | find_index: 'id', block.id
    assign current = block_index | modulo: 3 | plus: 1
-%}

{%- capture btn_video -%}
  {%- if block.settings.video_control -%}
    {%- liquid
    if block.settings.video_source == 'shopify_hosted'
      assign description = block.settings.video.alt | escape
    else
      assign description = block.settings.description | default: block.settings.video_url.type | escape
    endif
    -%}
    <hdt-btn-video class="hdt-btn-ctrl_media-abs" transRight>
      <button type="button" class="hdt-btn-control_media hdt-btn-video" aria-label="{{ 'accessibility.video.play' | t: description: description | escape }}" data-pause="{{ 'accessibility.video.pause' | t: description: description | escape }}">
          <span class="hdt-ic-play-wrap">{{ 'icon-play.svg' | inline_asset_content }}</span>
          <span class="hdt-ic-pause-wrap">{{ 'icon-pause.svg' | inline_asset_content }}</span>
          <span class="hdt-ic-video_progress">{{ 'icon-progress-imgtab.svg' | inline_asset_content }}</span>
      </button>
    </hdt-btn-video>
  {%- endif -%}
{%- endcapture -%}

<div class="hdt-hero-media" color-scheme="{{ block.settings.color_scheme }}" id="block-{{ block.id }}" {{ block.shopify_attributes }}>
  <div class="hdt-media-overlap-content hdt-rounded{% if section.settings.media_height == 'full' %} hdt-height--full{% endif %}" style="--color-overlay-opacity: {{ block.settings.media_overlay_opacity }}%; {%- if block.settings.image_mb.presentation.focal_point != blank %}--object-pos-mb: {{ block.settings.image_mb.presentation.focal_point }};{% endif -%}">
      {%- if block.settings.media_type == 'image'  -%}
          {%- liquid
              if block.settings.image != blank
                assign append_w = block.settings.image.width | default: 4000
                assign widths = '400,600,800,1000,1200,1400,1600,1800,2000,2200,2400,2600,2800,3000,3200,3400,3600' | append: append_w
                echo '<picture class="hdt-media-wrapper">'
                if block.settings.image_mb != blank and block.settings.image_mb != block.settings.image
                  assign append_w_mb = block.settings.image_mb.width | default: 1000
                  assign widths_mb = '200,400,600,800,1000,' | append: append_w_mb
                  assign srcset = block.settings.image_mb | image_url: width: block.settings.image_mb.width | image_tag: widths: widths_mb, alt: null | split: 'srcset="' | last
                  unless srcset contains 'src='
                    echo '<source media="(max-width: 767px)" srcset="' | append: srcset | replace_first: 'style=', 'data-none='
                  endunless
                endif
                echo block.settings.image | image_url: width: block.settings.image.width | image_tag: loading: loading, sizes: '100vw', class: class_object_mb, widths: widths
                echo '</picture>'
              else
                echo '<div class="hdt-media-wrapper">'
                echo 'hero-apparel-' | append: current | placeholder_svg_tag: 'placeholder-svg hdt-placeholder'
                echo '</div>'
              endif
          -%}
          {%- else -%}
          <div class="hdt-media-wrapper">
            {%- if block.settings.video_source == 'shopify_hosted' -%}
              {%- liquid
              if block.settings.video != blank
                echo '<hdt-video duration autoplay type="html5" id="Video-[id]" data-loop="true" is--lazy>' | replace_first: '[id]', block.id
                  render 'video', video: block.settings.video, show_image: true, image: block.settings.image_video, sizes: '100vw', hidden_poster: true, lazyload: true, widths: '300,400,600,800,1000,1200,1400,1600,1800,2000,2200,2400,2600,2800,3000,3200'
                  echo btn_video
                echo '</hdt-video>'
              else
                if block.settings.image_video != blank
                  assign widths = '300,400,600,800,1000,1200,1400,1600,1800,2000,2200,2400,2600,2800,3000,3200,' | append: block.settings.image_video.width
                  echo block.settings.image_video | image_url: width: block.settings.image_video.width | image_tag: widths: widths, loading: loading, sizes: '100vw'
                else
                  echo 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg hdt-placeholder'
                endif
              endif
              -%}
            {%- else -%}
              {%- capture player_id %}player-{{ block.id }}{% endcapture -%}
              <hdt-video duration autoplay type="{{ block.settings.video_url.type }}" background data-loop="true" data-id="{{ player_id }}">
                {%- liquid
                assign image = block.settings.image_video | default: block.settings.video.preview_image
                if image != blank
                assign widths = '300,400,600,800,1000,1200,1400,1600,1800,2000,2200,2400,2600,2800,3000,3200,' | append: image.width
                echo image | image_url: width: image.width | image_tag: widths: widths, loading: loading, sizes: '100vw'
                endif
                -%}
                <template>
                  {%- render 'iframe', video_url: block.settings.video_url, player_id: player_id, description: block.settings.description -%}
                </template>
                {{- btn_video -}}
              </hdt-video>
            {%- endif -%}
          </div>
      {%- endif -%}
      {% content_for 'block', type: '_hero_content', id: 'hero_content' %}
  </div>
</div>

{% schema %}
    {
        "name": "t:names.hero_media",
        "tag": null,
        "settings": [
          {
            "type": "select",
            "id": "media_type",
            "label": "t:settings.media_type",
            "options": [
                {
                    "label": "t:options.image",
                    "value": "image"
                },
                {
                    "label": "t:options.video",
                    "value": "video"
                }
            ],
            "default": "image"
          },
          {
              "type": "image_picker",
              "id": "image",
              "label": "t:settings.image",
              "visible_if": "{{ block.settings.media_type == 'image' }}"
          },
          {
              "type": "image_picker",
              "id": "image_mb",
              "label": "t:settings.image_mb",
              "info": "t:info.image_mb",
              "visible_if": "{{ block.settings.media_type == 'image' }}"
          },
          {
              "type": "select",
              "id": "video_source",
              "label": "t:settings.video_source",
              "options": [
                  {
                      "value": "shopify_hosted",
                      "label": "t:options.shopify_hosted"
                  },
                  {
                      "value": "from_url",
                      "label": "t:options.embed_video_url"
                  }
              ],
              "default": "shopify_hosted",
              "visible_if": "{{ block.settings.media_type == 'video' }}"
          },
          {
              "type": "video",
              "id": "video",
              "label": "t:settings.video",
              "visible_if": "{{ block.settings.media_type == 'video' and block.settings.video_source == 'shopify_hosted' }}"
          },
          {
              "type": "video_url",
              "id": "video_url",
              "accept": ["youtube", "vimeo"],
              "default": "https://www.youtube.com/watch?v=_9VUPq3SxOc",
              "label": "t:settings.video_url",
              "info": "t:info.video_url",
              "visible_if": "{{ block.settings.media_type == 'video' and block.settings.video_source == 'from_url' }}"
          },
          {
            "type": "checkbox",
            "id": "video_control",
            "label": "t:settings.video_control",
            "default": false,
            "visible_if": "{{ block.settings.media_type == 'video' }}"
          },
          {
              "type": "image_picker",
              "id": "image_video",
              "label": "t:settings.image_video",
              "info": "t:info.image_video",
              "visible_if": "{{ block.settings.media_type == 'video' }}"
          },
          {
              "type": "text",
              "id": "description",
              "label": "t:settings.video_alt_text",
              "info": "t:info.video_alt_text",
              "visible_if": "{{ block.settings.media_type == 'video' }}"
          },
          {
            "type": "range",
            "id": "media_overlay_opacity",
            "label": "t:settings.media_overlay_opacity",
            "min": 0,
            "max": 100,
            "unit": "%",
            "default": 0,
          },
          {
            "type": "header",
            "content": "t:content.appearance"
          },
          {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:settings.color_scheme",
            "default": "scheme-1"
          },
        ],
        "presets": [
            {
              "name": "t:names.hero_media",
              "blocks": [
                {
                  "type": "_hero_content",
                  "static": true,
                  "id": "hero_content",
                  "blocks": [
                    {"type": "heading"},
                    {
                      "type": "text",
                      "settings": {
                          "text_size": "xl"
                      }
                    },
                  ]
                }
              ]
            },
        ]
    }
{% endschema %}

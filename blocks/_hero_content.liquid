<div class="hdt-media-content hdt-place-self-{{ block.settings.content_position }} md:hdt-place-self-{{ block.settings.content_position_md }}" style="--overlap-content-mw: {{ block.settings.max_width_content }}px">
    <div class="hdt-media-content-wrapp">
      {%- content_for 'blocks' -%}
    </div>
</div>
{% schema %}
  {
    "name": "t:names.banner_content",
    "tag":null,
    "blocks": [{"type": "label"}, {"type": "heading"}, {"type": "text"},{"type": "countdown-timer-box"}, {"type": "group-button"},{"type": "spacer"}],
    "settings": [
      {
        "type": "range",
        "id": "max_width_content",
        "label": "t:settings.max_width_content",
        "min": 300,
        "max": 900,
        "step": 10,
        "unit": "px",
        "default": 680,
      },
      {
        "type": "select",
        "id": "content_position_md",
        "label": "t:settings.content_position_xl",
        "default": "center-start md:hdt-text-start",
        "options": [
          {
            "value": "start md:hdt-text-start",
            "label": "t:options.top_left"
          },
          {
            "value": "start-center md:hdt-text-center",
            "label": "t:options.top_center"
          },
          {
            "value": "start-end md:hdt-text-end",
            "label": "t:options.top_right"
          },
          {
            "value": "center-start md:hdt-text-start",
            "label": "t:options.middle_left"
          },
          {
            "value": "center md:hdt-text-center",
            "label": "t:options.middle_center"
          },
          {
            "value": "center-end md:hdt-text-end",
            "label": "t:options.middle_right"
          },
          {
            "value": "end-start md:hdt-text-start",
            "label": "t:options.bottom_left"
          },
          {
            "value": "end-center md:hdt-text-center",
            "label": "t:options.bottom_center"
          },
          {
            "value": "end md:hdt-text-end",
            "label": "t:options.bottom_right"
          }
        ],
      },
      {
          "type": "select",
          "id": "content_position",
          "label": "t:settings.content_position",
          "default": "center-start hdt-text-start",
          "options": [
            {
              "value": "start hdt-text-start",
              "label": "t:options.top_left"
            },
            {
              "value": "start-center hdt-text-center",
              "label": "t:options.top_center"
            },
            {
              "value": "start-end hdt-text-end",
              "label": "t:options.top_right"
            },
            {
              "value": "center-start hdt-text-start",
              "label": "t:options.middle_left"
            },
            {
              "value": "center hdt-text-center",
              "label": "t:options.middle_center"
            },
            {
              "value": "center-end hdt-text-end",
              "label": "t:options.middle_right"
            },
            {
              "value": "end-start hdt-text-start",
              "label": "t:options.bottom_left"
            },
            {
              "value": "end-center hdt-text-center",
              "label": "t:options.bottom_center"
            },
            {
              "value": "end hdt-text-end",
              "label": "t:options.bottom_right"
            }
          ],
      },
    ],
    "presets": [
      {
        "name": "t:names.banner_content",
        "blocks": [
          {"type": "heading"},
          {
            "type": "text",
            "settings": {
                "text_size": "xl"
            }
          },
        ]
      }
    ]
  }
{% endschema %}

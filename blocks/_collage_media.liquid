{%- liquid
    if section.index == 1
      assign loading = 'eager'
    else
      assign loading = 'lazy'
    endif
    assign column = block.settings.grid_column_ident
    if section.settings.select_grid == '10'
        assign column_ident_xl_ratio  = 10 | divided_by: block.settings.grid10_column_ident_xl
        assign column_ident_md_ratio = 10 | divided_by: block.settings.grid10_column_ident_md
        assign column_md = block.settings.grid10_column_ident_md
        assign column_xl = block.settings.grid10_column_ident_xl
    else
        assign column_ident_xl_ratio  = 12 | divided_by: block.settings.grid12_column_ident_xl
        assign column_ident_md_ratio = 12 | divided_by: block.settings.grid12_column_ident_md
        assign column_md = block.settings.grid12_column_ident_md
        assign column_xl = block.settings.grid12_column_ident_xl
    endif
-%}
{%- capture sizes -%}
  (min-width: {{ settings.page_width }}px) {{ settings.page_width | divided_by: column_ident_xl_ratio }}px, (min-width: 1150px) calc((100vw - 100px) / {{ column_ident_xl_ratio }}), (min-width: 768px) calc((100vw - 60px) / {{ column_ident_md_ratio }}), calc({{ 50 | times: block.settings.grid_column_ident }}vw - 30px)
{%- endcapture -%}

<div {{ block.shopify_attributes }} class="hdt-collage-item hdt-hover-effblur" color-scheme="{{ block.settings.color_scheme }}" style="--collage-col-ident-xs: {{ column }};--collage-col-ident-md: {{ column_md }};--collage-col-ident-xl: {{ column_xl }}; --collage-row-ident-xs: {{ block.settings.row_ident }};--collage-row-ident-md: {{ block.settings.row_ident_md }};--collage-row-ident-xl: {{ block.settings.row_ident_xl }};">
    <div class="hdt-media-overlap-content hdt-h-full hdt-rounded-sm hdt-hover-zoommedia" style="--color-overlay-opacity: {{ block.settings.media_overlay_opacity }}%;">
      {%- if block.settings.button_link != blank %}<a href="{{ block.settings.button_link }}" class="hdt-full-width-link"{% if block.settings.open_in_new_tab %} aria-describedby="a11y-new-window-message" target="_blank" rel="noopener noreferrer"{% endif %}><span class="sr-only">{{ block.settings.button_label | escape }}</span></a>{% endif -%}
      <div class="hdt-media-wrapper">
        {%- if block.settings.media_type == 'image' -%}
            {%- liquid
                if block.settings.image != blank
                  assign widths = '300,400,600,800,1000,1200,1400,1600,1800,2000,2200,2400,2600,2800,3000,3200,' | append: block.settings.image.width
                  echo block.settings.image | image_url: width: block.settings.image.width | image_tag: widths: widths, loading: loading, sizes: sizes, class: 'hdt-zoom-img'
                else
                  capture current
                  cycle 1, 2 , 3
                  endcapture
                  echo 'hero-apparel-' | append: current | placeholder_svg_tag: 'placeholder-svg hdt-placeholder hdt-zoom-img'
                endif
            -%}
        {%- else -%}
            {%- if block.settings.video != blank -%}
                <hdt-video {% if block.settings.autoplay %}autoplay{% endif %} type="html5">
                  {%- liquid
                    assign image = block.settings.image_poster | default: block.settings.video.preview_image
                    assign widths = '300,400,600,800,1000,1200,1400,1600,1800,2000,2200,2400,2600,2800,3000,3200,' | append: image.width
                    echo image | image_url: width: image.width | image_tag: widths: widths, loading: loading, sizes: sizes, class: 'hdt-zoom-img'
                    unless block.settings.video contains ' alt='
                      echo block.settings.video | video_tag: image_size: '500x', playsinline: true, muted: block.settings.autoplay, loop: true, controls: false, preload: 'none' | replace_first: '<img ', '<img alt="" '
                    else
                      echo block.settings.video | video_tag: image_size: '500x', playsinline: true, muted: block.settings.autoplay, loop: true, controls: false, preload: 'none'
                    endunless
                  -%}
                </hdt-video>
            {%- else -%}
                {%- liquid
                  if block.settings.image_poster != blank
                    assign widths = '300,400,600,800,1000,1200,1400,1600,1800,2000,2200,2400,2600,2800,3000,3200,' | append: block.settings.image_poster.width
                    echo block.settings.image_poster | image_url: width: block.settings.image_poster.width | image_tag: widths: widths, loading: loading, sizes: sizes
                  else
                    capture current
                    cycle 1, 2 , 3
                    endcapture
                    echo 'hero-apparel-' | append: current | placeholder_svg_tag: 'placeholder-svg hdt-placeholder hdt-zoom-img'
                  endif
                -%}
            {%- endif -%}
        {%- endif -%}
      </div>
      <div class="hdt-media-content hdt-place-self-{{ block.settings.content_position }} md:hdt-place-self-{{ block.settings.content_position_xl }} hdt-hide-bg-content{% if block.settings.button_label != blank %} hdt-has-btn-{{ block.settings.button_size }} hdt-has-btn-{{ block.settings.button_style }}{% endif %}">
        <div class="hdt-inner-content">{%- content_for 'blocks' -%}</div>
        {%- if block.settings.button_label != blank -%}
        <a tabindex="-1" {% if block.settings.button_link != blank %} href="{{ block.settings.button_link }}"{% else %} role="link" aria-disabled="true"{% endif %}{% if block.settings.open_in_new_tab %} target="_blank" aria-describedby="a11y-new-window-message" rel="noopener noreferrer"{% endif %} class="{% unless block.settings.button_style == 'link' %}hdt-btn{% endunless %} hdt-btn-{{ block.settings.button_style }} hdt-btn--inner hdt-btn--size-{{ block.settings.button_size }}{% if block.settings.icon_button %} hdt-btn--with-icon{% endif %}{% if block.settings.btn_uppercase and settings.btn_case != 'uppercase' %} hdt-uppercase{% endif %}">
          <span circle-bg-wrap class="hdt-inner-btn">
            <span>{{- block.settings.button_label -}}</span>
            {%- if block.settings.icon_button %}{{ 'icon-' | append: block.settings.icon_btn_custom | append: '.svg' | inline_asset_content }}{% endif -%}
            {%- if block.settings.button_style == 'link' -%}
                {{- 'icon-slide.svg' | inline_asset_content -}}
            {%- else -%}
            <hdt-circle-bg mousemove></hdt-circle-bg>
            {%- endif -%}
          </span>
        </a>
        {%- endif -%}
      </div>
    </div>
</div>


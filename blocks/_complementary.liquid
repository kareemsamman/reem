{%- liquid
  assign product = section.settings.product | default: product
  assign product_recommendations = product.metafields.shopify--discovery--product_recommendation.complementary_products.value
  assign sizes = '(min-width: 480px) 115px, calc(100vw - 30px)'
-%}
{%- if product_recommendations != blank -%}
<div class="hdt-product-info__item hdt-product__complementary hdt-product-info__item--text-box" data-type="complementary" {{ block.shopify_attributes }}>
  <fieldset class="hdt-pc--fieldset hdt-border hdt-rounded-sm">
    <legend class="hdt-product__complementary-title hdt-h6">{{ block.settings.title }}</legend>
    <div class="hdt-pc--slide-container hdt-tab-block hdt-pc--slide-container-single" data-auto_switch="{{ block.settings.auto_play }}">
      <hdt-slider id="Slider-{{ block.id }}" class="hdt-slider hdt-product__complementary-products hdt-relative hdt-slides-1{% if block.settings.auto_play %} hdt-slide_autoplay{% endif %}" {% if block.settings.auto_play %} autoplay="{{ block.settings.change_every | times: 1000 }}" style="--hdt-remaining: {{ block.settings.change_every | times: 1000 }}ms"{% endif %}{% if block.settings.pause_on_hover %} pause-on-hover{% endif %}>
        <div class="hdt-slider__viewport hdt-ratio--{{ block.settings.image_ratio }}">
          <div class="hdt-slider__container">
            {%- for product in product_recommendations limit: block.settings.product_list_limit -%}
              {%- assign image = product.featured_image | default: settings.placeholder_img -%}
              <div class="hdt-product__complementary-product hdt-slider__slide">
                <a href="{{ product.url }}" calc-nav class="hdt-product__complementary-product-image hdt-rounded-sm hdt-oh hdt-ratio{% if block.settings.enable_quick_view %} hdt-product-has-qv{% endif %}"{% if block.settings.image_ratio == 'adapt_image' %} style="--aspect-ratioapt: {{ image.aspect_ratio | default: 1 }}"{% endif %}>
                  {%- if image != blank -%}
                    {{- image | image_url: width: 800 | image_tag: loading: 'lazy', width: image.width, height: image.height, sizes: sizes, widths: '150, 200, 250, 300, 350, 400, 450, 500' -}}
                  {%- else -%}
                  {%- liquid
                    capture current
                    cycle 2, 1 , 3, 4
                    endcapture
                    echo 'product-apparel-' | append: current | placeholder_svg_tag: 'placeholder-svg hdt-placeholder hdt-w-full hdt-h-full'
                  -%}
                  {%- endif -%}
                </a>
                <div class="hdt-product__complementary-product-info">
                  <p class="hdt-product__complementary-product-title"><a class="hdt-link hdt-font-semibold hdt-text-lg" href="{{ product.url }}">{{ product.title }}</a></p>
                  {%- render 'item-price', product: product, price_class: 'hdt-product__complementary-product-price hdt-text-lg hdt-font-semibold' -%}
                  {%- if product.has_only_default_variant and block.settings.enable_quick_view -%}
                    {%- liquid
                      assign product_form_id = 'form-' | append: section.id | append: product.id
                      assign quantity_rule = product.selected_or_first_available_variant.quantity_rule
                      assign quantity_rule_min = quantity_rule.min | default: 1
                    -%}
                    <product-form class="hdt-contents">
                      {%- form 'product', product, id: product_form_id, class: 'hdt-contents', novalidate: 'novalidate' -%}
                        <input type="hidden" name="quantity" value="{{ quantity_rule_min }}">
                        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                        <button aria-label="{{ 'products.product.add_to_cart' | t }}" type="submit" name="add" class="hdt-product-card-btn hdt-btn--loading_spinner hdt-product-card-btn--atc hdt-btn hdt-btn--inner hdt-btn--size-s hdt-btn--with-icon">
                          <span circle-bg-wrap class="hdt-inner-btn">
                            <span>{{- 'icon-addtocart.svg' | inline_asset_content -}}</span>
                            <span class="sr-only-mobile">{{ 'products.product.add_to_cart' | t }}</span>
                            {%- render 'loading-spinner', class: 'hdt-loading-area__spinner' -%}
                            <hdt-circle-bg mousemove></hdt-circle-bg>
                          </span>
                        </button>
                      {%- endform -%}
                    </product-form>
                  {%- elsif block.settings.enable_quick_view -%}
                    <wrapp-hdt-open-btn class="hdt-contents hdt-open-quickview-wrapp">
                      <button circle-bg-wrap type="button" handle="{{ product.handle }}" aria-controls="hdt-quick-view-modal" class="hdt-open-quickview-btn hdt-btn hdt-btn--size-s hdt-btn--with-icon" aria-expanded="false">
                        {{- 'icon-quickview-rc.svg' | inline_asset_content -}}
                        {{- 'products.product.quick_view' | t -}}
                        <hdt-circle-bg mousemove></hdt-circle-bg>
                      </button>
                    </wrapp-hdt-open-btn>
                  {%- endif -%}
                </div>
              </div>
            {%- endfor -%}
          </div>
        </div>
        <hdt-slider-dots aria-controls="Slider-{{ block.id }}" class="hdt-slider-dots hdt-slider-dots__progressbar"></hdt-slider-dots>
      </hdt-slider>
    </div>
  </fieldset>
</div>
{%- endif -%}

{% schema %}
{
  "name": "t:names.complementary_products",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.complementary_products"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:settings.heading",
      "default": "t:text_defaults.buy_to_with"
    },
    {
      "type": "range",
      "id": "product_list_limit",
      "label": "t:settings.max_product_show",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 10
    },
    {
      "type": "checkbox",
      "id": "auto_play",
      "label": "t:settings.auto_rotate",
      "default": false
    },
    {
      "type": "range",
      "id": "change_every",
      "min": 3,
      "max": 20,
      "step": 1,
      "unit": "s",
      "label": "t:settings.duration",
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "t:settings.pause_on_hover",
      "default": true
    },
    {
      "type": "header",
      "content": "t:content.product_card"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt_image",
          "label": "t:options.adapt_to_image"
        },
        {
          "value": "portrait",
          "label": "t:options.portrait"
        },
        {
          "value": "square",
          "label": "t:options.square"
        },
        {
          "value": "landscape",
          "label": "t:options.landscape"
        },
        {
          "value": "4-3",
          "label": "t:options.4_3"
        }
      ],
      "default": "adapt_image",
      "label": "t:settings.image_ratio"
    },
    {
      "type": "checkbox",
      "id": "enable_quick_view",
      "label": "t:settings.show_quickadd_or_qv",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "t:names.complementary_products"
    }
  ]
}
{% endschema %}